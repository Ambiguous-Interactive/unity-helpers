+// MIT License - Copyright (c) 2026 wallstop
+// Full license text: https://github.com/wallstop/unity-helpers/blob/main/LICENSE
+
+namespace ProtoBuf.Serializers
+{
+    using System;
+    using System.Collections.Generic;
+    using ProtoBuf.Internal;
+
+    internal static class CollectionWrapperSerializers
+    {
+        private static readonly Dictionary<Type, CollectionWrapperSerializer> serializers =
+            new Dictionary<Type, CollectionWrapperSerializer>();
+
+        internal static void Register(CollectionWrapperSerializer serializer)
+        {
+            if (serializer is null)
+            {
+                ThrowHelper.ThrowArgumentNullException(nameof(serializer));
+            }
+            lock (serializers)
+            {
+                if (
+                    serializers.TryGetValue(
+                        serializer.CollectionType,
+                        out CollectionWrapperSerializer existing
+                    )
+                )
+                {
+                    if (!ReferenceEquals(existing, serializer))
+                    {
+                        ThrowHelper.ThrowInvalidOperationException(
+                            "A different collection wrapper serializer is already registered."
+                        );
+                    }
+                    return;
+                }
+                serializers.Add(serializer.CollectionType, serializer);
+            }
+        }
+
+        internal static CollectionWrapperSerializer Resolve(Type collectionType)
+        {
+            if (collectionType is null)
+            {
+                return null;
+            }
+            RepeatedSerializers.EnsureTypedProviderInitialized(collectionType);
+            lock (serializers)
+            {
+                return serializers.TryGetValue(
+                    collectionType,
+                    out CollectionWrapperSerializer serializer
+                )
+                    ? serializer
+                    : null;
+            }
+        }
+    }
+}
