diff --git a/src/protobuf-net/Internal/Serializers/ExternalSerializerFactories.cs b/src/protobuf-net/Internal/Serializers/ExternalSerializerFactories.cs
new file mode 100644
--- /dev/null
+++ b/src/protobuf-net/Internal/Serializers/ExternalSerializerFactories.cs
@@ -0,0 +1,87 @@
+// MIT License - Copyright (c) 2026 wallstop
+// Full license text: https://github.com/wallstop/unity-helpers/blob/main/LICENSE
+
+namespace ProtoBuf.Internal.Serializers
+{
+    using System;
+    using System.Collections.Generic;
+    using ProtoBuf.Serializers;
+
+    internal static class ExternalSerializerFactories
+    {
+        private static readonly Dictionary<
+            (Type Provider, Type Target),
+            Func<IProtoTypeSerializer>
+        > factories = new();
+        private static readonly Dictionary<
+            (Type Provider, Type Target),
+            Func<object, IProtoTypeSerializer>
+        > nullableFactories = new();
+
+        internal static void Register<TProvider, T>()
+            where TProvider : class
+        {
+            lock (factories)
+            {
+                (Type, Type) key = (typeof(TProvider), typeof(T));
+                if (!factories.ContainsKey(key))
+                {
+                    factories.Add(key, static () => new ExternalSerializer<TProvider, T>());
+                }
+            }
+        }
+
+        internal static void RegisterNullable<TProvider, T>()
+            where TProvider : class
+            where T : struct
+        {
+            Register<TProvider, T>();
+            lock (factories)
+            {
+                (Type, Type) key = (typeof(TProvider), typeof(T?));
+                if (!nullableFactories.ContainsKey(key))
+                {
+                    nullableFactories.Add(
+                        key,
+                        static service =>
+                            service is ISerializer<T?> typed
+                                ? new ExternalSerializer<TProvider, T?>(typed)
+                                : null
+                    );
+                }
+            }
+        }
+
+        internal static bool IsRegistered(Type provider, Type target)
+        {
+            lock (factories)
+            {
+                return factories.ContainsKey((provider, target));
+            }
+        }
+
+        internal static IProtoTypeSerializer TryCreate(Type provider, Type target)
+        {
+            Func<IProtoTypeSerializer> factory;
+            lock (factories)
+            {
+                factories.TryGetValue((provider, target), out factory);
+            }
+            return factory?.Invoke();
+        }
+
+        internal static IProtoTypeSerializer TryCreateNullable(
+            Type provider,
+            Type target,
+            object service
+        )
+        {
+            Func<object, IProtoTypeSerializer> factory;
+            lock (factories)
+            {
+                nullableFactories.TryGetValue((provider, target), out factory);
+            }
+            return factory?.Invoke(service);
+        }
+    }
+}
