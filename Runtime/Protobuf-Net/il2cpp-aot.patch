+        private static readonly bool s_dynamicCodeAvailable = ProbeDynamicCode();
+
+        internal static bool DynamicCodeAvailable => s_dynamicCodeAvailable;
+
+        [MethodImpl(MethodImplOptions.NoInlining)]
+        internal static bool EnableAutoCompile()
+        {
+            return DynamicCodeAvailable;
+        }
+
+        [MethodImpl(MethodImplOptions.NoInlining)]
+        private static bool ProbeDynamicCode()
+        {
+            try
+            {
+                var dm = new DynamicMethod("CheckCompilerAvailable", typeof(bool), [typeof(int)]);
+                var il = dm.GetILGenerator();
+                il.Emit(OpCodes.Ldarg_0);
+                il.Emit(OpCodes.Ldc_I4, 42);
+                il.Emit(OpCodes.Ceq);
+                il.Emit(OpCodes.Ret);
+                var func = (Predicate<int>)dm.CreateDelegate(typeof(Predicate<int>));
+                return func(42);
+            }
+            catch (Exception ex)
+            {
+                Debug.WriteLine(ex);
+                return false;
+            }
+        }
