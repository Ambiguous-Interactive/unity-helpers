+++ b/src/protobuf-net.Core/ISerializationWriteScope.cs
@@ -0,0 +1,12 @@
+namespace ProtoBuf
+{
+    /// <summary>Owns temporary resources for one reference type contract write, including callbacks.</summary>
+    public interface ISerializationWriteScope
+    {
+        /// <summary>Begins one write scope; nested writes must preserve the enclosing scope.</summary>
+        void BeginSerialization();
+
+        /// <summary>Releases the current scope and restores its enclosing scope without throwing.</summary>
+        void EndSerialization();
+    }
+}
