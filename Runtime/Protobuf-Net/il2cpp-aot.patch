+++ b/src/protobuf-net/Internal/Serializers/RuntimeTypeSerializer.cs
@@ -0,0 +1,42 @@
+// MIT License - Copyright (c) 2026 wallstop
+// Full license text: https://github.com/wallstop/unity-helpers/blob/main/LICENSE
+
+namespace ProtoBuf.Internal.Serializers
+{
+    using System;
+    using System.Runtime.CompilerServices;
+
+    internal sealed class RuntimeTypeSerializer : TypeSerializer<object>
+    {
+        public override Type ExpectedType => expectedType;
+
+        internal override Type BaseType => expectedType;
+
+        private readonly Type expectedType;
+
+        internal RuntimeTypeSerializer(Type expectedType)
+        {
+            this.expectedType = expectedType;
+        }
+
+        public override void Write(ref ProtoWriter.State state, object value)
+        {
+            if (expectedType.IsValueType && value is not null)
+            {
+                value = RuntimeHelpers.GetObjectValue(value);
+            }
+            base.Write(ref state, value);
+        }
+
+        public override object Read(ref ProtoReader.State state, object value)
+        {
+            if (expectedType.IsValueType)
+            {
+                value = value is null
+                    ? BclHelpers.GetUninitializedObject(expectedType)
+                    : RuntimeHelpers.GetObjectValue(value);
+            }
+            return base.Read(ref state, value);
+        }
+    }
+}
