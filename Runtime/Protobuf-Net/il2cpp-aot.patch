+        internal bool ShouldWrite(object value)
+        {
+            return Nullable.GetUnderlyingType(type) is not null ? value is not null : HasNonTrivialValue(value);
+        }
+
+        private bool HasNonTrivialValue(object value)
+        {
+            Type type = Nullable.GetUnderlyingType(this.type) ?? this.type;
+            if (type.IsEnum) return value is not null;
+            // Reuse the original concrete primary checkers, including special reference policies.
+            if (type == typeof(byte[])) return Check<byte[]>(value);
+            if (type == typeof(Uri)) return Check<Uri>(value);
+            if (type == typeof(Type)) return Check<Type>(value);
+            if (type == typeof(Guid)) return Check<Guid>(value);
+            if (type == typeof(TimeSpan)) return Check<TimeSpan>(value);
+            if (type == typeof(IntPtr)) return Check<IntPtr>(value);
+            if (type == typeof(UIntPtr)) return Check<UIntPtr>(value);
+            if (type == typeof(ArraySegment<byte>)) return Check<ArraySegment<byte>>(value);
+            if (type == typeof(Memory<byte>)) return Check<Memory<byte>>(value);
+            if (type == typeof(ReadOnlyMemory<byte>)) return Check<ReadOnlyMemory<byte>>(value);
+            return Type.GetTypeCode(type) switch
+            {
+                TypeCode.Boolean => Check<bool>(value),
+                TypeCode.Byte => Check<byte>(value),
+                TypeCode.SByte => Check<sbyte>(value),
+                TypeCode.Int16 => Check<short>(value),
+                TypeCode.UInt16 => Check<ushort>(value),
+                TypeCode.Int32 => Check<int>(value),
+                TypeCode.UInt32 => Check<uint>(value),
+                TypeCode.Int64 => Check<long>(value),
+                TypeCode.UInt64 => Check<ulong>(value),
+                TypeCode.Char => Check<char>(value),
+                TypeCode.Single => Check<float>(value),
+                TypeCode.Double => Check<double>(value),
+                TypeCode.Decimal => Check<decimal>(value),
+                TypeCode.DateTime => Check<DateTime>(value),
+                TypeCode.String => Check<string>(value),
+                _ => type.IsValueType || value is not null,
+            };
+        }
+
+        private static bool Check<T>(object value)
+        {
+            return TypeHelper<T>.ValueChecker.HasNonTrivialValue(TypeHelper<T>.FromObject(value));
+        }
+    }
+}
