+        private readonly HashSet<Type> nullableContractTypes = new HashSet<Type>();
+
+        internal void NoteNullableContract(Type type, CompatibilityLevel compatibilityLevel)
+        {
+            Type underlying = Nullable.GetUnderlyingType(type);
+            if (underlying is null || underlying.IsEnum) return;
+            if (ValueMember.TryGetCoreSerializer(this, DataFormat.Default, compatibilityLevel, underlying,
+                out _, false, false, false, false) is not null) return;
+            if (FindOrAddAuto(underlying, false, true, false, compatibilityLevel) < 0) return;
+            lock (_serviceCache)
+            {
+                nullableContractTypes.Add(type);
+            }
+        }
+
+
+        internal void NoteNullableEnum(Type type, CompatibilityLevel compatibilityLevel)
+        {
+            RepeatedSerializerStub repeated = TryGetRepeatedProvider(type, compatibilityLevel);
+            Type underlying = Nullable.GetUnderlyingType(repeated is null ? type : repeated.ItemType);
+            if (underlying is not null && underlying.IsEnum)
+            {
+                FindOrAddAuto(underlying, true, false, true, compatibilityLevel);
+            }
+        }
+
+        private readonly Hashtable _serviceCache = [];
+        internal void ResetServiceCache(Type type)
+        {
+            if (type is not null)
+            {
+                lock (_serviceCache)
+                {
+                    _serviceCache.Remove(type);
+                    lock (_runtimeDictionaryEnumItems)
+                    {
+                        _runtimeDictionaryEnumItems.Remove(type);
+                        if (type.IsValueType && Nullable.GetUnderlyingType(type) is null)
+                        {
+                            Type nullableType = typeof(Nullable<>).MakeGenericType(type);
+                            _serviceCache.Remove(nullableType);
+                            _runtimeDictionaryEnumItems.Remove(nullableType);
+                        }
+                    }
+                }
+            }
+        }
+
+        private object GetServicesSlow(Type type, CompatibilityLevel ambient)
+        {
+            if (type is null) return null; // GIGO
+            object service;
+            lock (_serviceCache)
+            {   // once more, with feeling
+                service = _serviceCache[type];
+                if (service is not null) return service;
+            }
+            service = GetServicesImpl(this, type, ambient);
+            if (service is not null)
+            {
+                try
+                {
+                    _ = this[type]; // if possible, make sure that we've registered it, so we export a proxy if needed
+                }
+                catch { }
+                lock (_serviceCache)
+                {
+                    _serviceCache[type] = service;
+                }
+            }
+            return service;
+
+            static object GetServicesImpl(RuntimeTypeModel model, Type type, CompatibilityLevel ambient)
+            {
+                if (type.IsEnum) return EnumSerializers.GetSerializer(type);
+
+                var nt = Nullable.GetUnderlyingType(type);
+                if (nt is not null)
+                {
+                    // rely on the fact that we always do double-duty with nullables
+                    return model.GetServicesSlow(nt, ambient);
+                }
+
+                // rule out repeated (this has an internal cache etc)
+                var repeated = model.TryGetRepeatedProvider(type); // this handles ignores, etc
+                if (repeated is not null)
+                {
+                    if (repeated.IsMap)
+                    {
+                        repeated.ResolveMapTypes(out Type keyType, out Type valueType);
+                        model.NoteNullableEnum(keyType, ambient);
+                        model.NoteNullableEnum(valueType, ambient);
+                        model.NoteNullableContract(keyType, ambient);
+                        model.NoteNullableContract(valueType, ambient);
+                    }
+                    return repeated.Serializer;
+                }
+
+                int typeIndex = model.FindOrAddAuto(type, false, true, false, ambient);
+                if (typeIndex >= 0)
+                {
+                    var mt = (MetaType)model.types[typeIndex];
+                    var serializer = mt.Serializer;
+                    if (serializer is IExternalSerializer external)
+                    {
+                        return external.Service;
+                    }
+                    return serializer;
+                }
+
+                return null;
+            }
+
+        }
