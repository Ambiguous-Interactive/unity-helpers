+// MIT License - Copyright (c) 2026 wallstop
+// Full license text: https://github.com/wallstop/unity-helpers/blob/main/LICENSE
+
+namespace ProtoBuf.Internal.Serializers
+{
+    using System;
+    using System.Collections;
+    using System.Reflection;
+    using ProtoBuf.Meta;
+    using ProtoBuf.Serializers;
+
+    internal sealed class RuntimeMapPairSerializer : ISerializer<DictionaryEntry>
+    {
+        private readonly RuntimeMapSlot key, value;
+        internal RuntimeMapPairSerializer(RuntimeMapSlot key, RuntimeMapSlot value) { this.key = key; this.value = value; }
+        public SerializerFeatures Features => SerializerFeatures.CategoryMessage | SerializerFeatures.WireTypeString;
+        public DictionaryEntry Read(ref ProtoReader.State state, DictionaryEntry old)
+        {
+            object k = key.DefaultValue(), v = value.DefaultValue();
+            int field;
+            while (0 < (field = state.ReadFieldHeader()))
+            {
+                switch (field)
+                {
+                    case 1: k = key.ReadSlot(ref state, k); break;
+                    case 2: v = value.ReadSlot(ref state, v); break;
+                    default: state.SkipField(); break;
+                }
+            }
+            return new DictionaryEntry(key.CompleteMissing(state.Context, k), value.CompleteMissing(state.Context, v));
+        }
+        public void Write(ref ProtoWriter.State state, DictionaryEntry entry)
+        {
+            if (key.ShouldWrite(entry.Key)) key.WriteSlot(ref state, 1, entry.Key);
+            if (value.ShouldWrite(entry.Value)) value.WriteSlot(ref state, 2, entry.Value);
+        }
+    }
+}
diff --git a/src/protobuf-net/Internal/Serializers/RuntimeMapSerializer.cs b/src/protobuf-net/Internal/Serializers/RuntimeMapSerializer.cs
new file mode 100644
--- /dev/null
+++ b/src/protobuf-net/Internal/Serializers/RuntimeMapSerializer.cs
@@ -0,0 +1,167 @@
+// MIT License - Copyright (c) 2026 wallstop
+// Full license text: https://github.com/wallstop/unity-helpers/blob/main/LICENSE
+
+namespace ProtoBuf.Internal.Serializers
+{
+    using System;
+    using System.Collections;
+    using System.Reflection;
+    using ProtoBuf.Meta;
+    using ProtoBuf.Serializers;
+
+    #pragma warning disable CS0618 // Existing state sub-item APIs preserve nongeneric wrapper semantics.
+
+    // Source-only experiment: mutable built-in dictionaries on runtimes without dynamic code.
+    internal sealed class RuntimeMapSerializer : IMapSerializerBridge
+    {
+        public Type CollectionType { get; }
+        public Type KeyType { get; }
+        public Type ValueType { get; }
+        private readonly Func<object> factory;
+        private readonly RepeatedSerializerStub authoritativeStub;
+
+        private RuntimeMapSerializer(Type collectionType, Type keyType, Type valueType, Func<object> factory, RepeatedSerializerStub authoritativeStub)
+        {
+            CollectionType = collectionType;
+            KeyType = keyType;
+            ValueType = valueType;
+            this.factory = factory;
+            this.authoritativeStub = authoritativeStub;
+        }
+
+        internal static RuntimeMapSerializer TryCreate(RepeatedSerializerStub stub)
+        {
+            if (!stub.IsMap || stub.ForType.IsInterface || stub.ForType.IsAbstract
+                || !typeof(IDictionary).IsAssignableFrom(stub.ForType)) return null;
+            var provider = RuntimeTypeModel.GetUnderlyingProvider(stub.Provider, stub.ForType);
+            if (provider is not MethodInfo method || method.DeclaringType != typeof(MapSerializer)
+                || method.Name != nameof(MapSerializer.CreateDictionary)) return null;
+            stub.ResolveMapTypes(out Type keyType, out Type valueType);
+            if (!SupportsSlot(keyType) || !SupportsSlot(valueType)) return null;
+            var factory = RepeatedSerializers.ResolveMapFactory(stub.ForType, stub.Provider);
+            if (RequiresTypedFactory(stub.ForType) && factory is null) return null;
+            return new RuntimeMapSerializer(stub.ForType, keyType, valueType, factory, stub);
+        }
+
+        private static bool RequiresTypedFactory(Type type)
+        {
+            for (Type current = type; current is not null; current = current.BaseType)
+                if (current.IsDefined(typeof(TypedRepeatedProviderAttribute), false)) return true;
+            return false;
+        }
+
+        private static bool SupportsSlot(Type type)
+        {
+            // Service-dependent reference eligibility is checked against the current model before any I/O.
+            return !type.IsPointer && !type.IsByRef && !type.ContainsGenericParameters;
+        }
+
+        private IMapSerializerBridge GetAuthoritativeProvider()
+        {
+            // Unsupported services retain their original provider and exceptions; no fallback catches them.
+            return authoritativeStub.CreateAuthoritativeSerializer() as IMapSerializerBridge
+                ?? throw new InvalidCastException("The authoritative map provider has no runtime map bridge.");
+        }
+
+        internal object Initialize(object value)
+        {
+            if (value is null)
+            {
+                if (factory is not null) value = factory();
+                else
+                {
+                    if (RequiresTypedFactory(CollectionType))
+                        throw new InvalidOperationException("A typed runtime map factory is required.");
+                    value = Activator.CreateInstance(CollectionType, nonPublic: true);
+                }
+            }
+            if (value is not IDictionary dictionary || dictionary.IsReadOnly || dictionary.IsFixedSize)
+                throw new NotSupportedException("Runtime dictionary serialization requires a mutable IDictionary.");
+            return value;
+        }
+
+        public object ReadMap(ref ProtoReader.State state, object value, SerializerFeatures features,
+            SerializerFeatures keyFeatures, CompatibilityLevel keyCompatibilityLevel, DataFormat keyDataFormat,
+            SerializerFeatures valueFeatures, CompatibilityLevel valueCompatibilityLevel, DataFormat valueDataFormat)
+        {
+            if (!TryCreatePair(state.Model, keyFeatures, keyCompatibilityLevel, keyDataFormat,
+                valueFeatures, valueCompatibilityLevel, valueDataFormat, out var pair))
+                return GetAuthoritativeProvider().ReadMap(ref state, value, features, keyFeatures,
+                    keyCompatibilityLevel, keyDataFormat, valueFeatures, valueCompatibilityLevel, valueDataFormat);
+            if (features.HasAny(SerializerFeatures.OptionWrappedCollection))
+            {
+                features &= ~(SerializerFeatures.OptionWrappedCollection | SerializerFeatures.OptionWrappedCollectionGroup);
+                var token = state.StartSubItem();
+                bool found = false;
+                int field;
+                while (0 < (field = state.ReadFieldHeader()))
+                {
+                    if (field == TypeModel.ListItemTag)
+                    {
+                        value = ReadMap(ref state, value, features, keyFeatures, keyCompatibilityLevel,
+                            keyDataFormat, valueFeatures, valueCompatibilityLevel, valueDataFormat);
+                        found = true;
+                    }
+                    else state.SkipField();
+                }
+                state.EndSubItem(token);
+                return found ? value : Initialize(value);
+            }
+            features.InheritFrom(pair.Features);
+            value = Initialize(value);
+            var dictionary = (IDictionary)value;
+            using var buffer = state.FillBuffer<RuntimeMapPairSerializer, DictionaryEntry>(features, pair, default);
+            if (features.HasAny(SerializerFeatures.OptionClearCollection)) dictionary.Clear();
+            foreach (var entry in buffer.Segment.AsSpan())
+            {
+                if (features.HasAny(SerializerFeatures.OptionFailOnDuplicateKey)) dictionary.Add(entry.Key, entry.Value);
+                else dictionary[entry.Key] = entry.Value;
+            }
+            return value;
+        }
+
+        public void WriteMap(ref ProtoWriter.State state, object value, int fieldNumber, SerializerFeatures features,
+            SerializerFeatures keyFeatures, CompatibilityLevel keyCompatibilityLevel, DataFormat keyDataFormat,
+            SerializerFeatures valueFeatures, CompatibilityLevel valueCompatibilityLevel, DataFormat valueDataFormat)
+        {
+            if (!TryCreatePair(state.Model, keyFeatures, keyCompatibilityLevel, keyDataFormat,
+                valueFeatures, valueCompatibilityLevel, valueDataFormat, out var pair))
+            {
+                GetAuthoritativeProvider().WriteMap(ref state, value, fieldNumber, features, keyFeatures,
+                    keyCompatibilityLevel, keyDataFormat, valueFeatures, valueCompatibilityLevel, valueDataFormat);
+                return;
+            }
+            if (features.HasAny(SerializerFeatures.OptionWrappedCollection))
+            {
+                state.WriteFieldHeader(fieldNumber, ProtoWriter.State.AssertWrappedAndGetWireType(ref features, out _));
+                var token = state.StartSubItem(null);
+                WriteMap(ref state, value, TypeModel.ListItemTag, features, keyFeatures, keyCompatibilityLevel,
+                    keyDataFormat, valueFeatures, valueCompatibilityLevel, valueDataFormat);
+                state.EndSubItem(token);
+                return;
+            }
+            if (value is null) return;
+            features.InheritFrom(pair.Features);
+            var iterator = ((IDictionary)value).GetEnumerator();
+            try
+            {
+                while (iterator.MoveNext()) state.WriteAny(fieldNumber, features, iterator.Entry, pair);
+            }
+            finally { (iterator as IDisposable)?.Dispose(); }
+        }
+
+        private bool TryCreatePair(TypeModel model,
+            SerializerFeatures keyFeatures, CompatibilityLevel keyCompatibilityLevel, DataFormat keyDataFormat,
+            SerializerFeatures valueFeatures, CompatibilityLevel valueCompatibilityLevel, DataFormat valueDataFormat,
+            out RuntimeMapPairSerializer pair)
+        {
+            pair = null;
+            if (model is not RuntimeTypeModel runtime) return false;
+            if (!RuntimeMapSlot.TryCreate(runtime, KeyType, keyFeatures, keyCompatibilityLevel, keyDataFormat, out var key)
+                || !RuntimeMapSlot.TryCreate(runtime, ValueType, valueFeatures, valueCompatibilityLevel, valueDataFormat, out var value)) return false;
+            pair = new RuntimeMapPairSerializer(key, value);
+            return true;
+        }
+    }
+
+}
diff --git a/src/protobuf-net/Internal/Serializers/RuntimeMapSlot.cs b/src/protobuf-net/Internal/Serializers/RuntimeMapSlot.cs
new file mode 100644
--- /dev/null
+++ b/src/protobuf-net/Internal/Serializers/RuntimeMapSlot.cs
@@ -0,0 +1,233 @@
+// MIT License - Copyright (c) 2026 wallstop
+// Full license text: https://github.com/wallstop/unity-helpers/blob/main/LICENSE
+
+namespace ProtoBuf.Internal.Serializers
+{
+    using System;
+    using ProtoBuf.Meta;
+    using ProtoBuf.Serializers;
+
+    internal sealed class RuntimeMapSlot : ISerializer<object>
+    {
+        private readonly Type type;
+        private readonly IRuntimeProtoSerializerNode node;
+        public SerializerFeatures SlotFeatures { get; }
+        public SerializerFeatures Features { get; }
+
+        private RuntimeMapSlot(Type type, IRuntimeProtoSerializerNode node,
+            SerializerFeatures features, SerializerFeatures slotFeatures)
+        {
+            this.type = type;
+            this.node = node;
+            Features = features;
+            slotFeatures.InheritFrom(features);
+            SlotFeatures = slotFeatures;
+        }
+
+        internal static bool TryCreate(RuntimeTypeModel model, Type type,
+            SerializerFeatures features, CompatibilityLevel compatibility, DataFormat format, out RuntimeMapSlot slot)
+        {
+            slot = null;
+            Type effective = Nullable.GetUnderlyingType(type) ?? type;
+            bool nullable = effective != type;
+            if (nullable && (effective == typeof(Memory<byte>) || effective == typeof(ReadOnlyMemory<byte>)
+                || effective == typeof(ArraySegment<byte>))) return false;
+            if (effective.IsEnum)
+            {
+                slot = new RuntimeMapSlot(type, new EnumMemberSerializer(effective),
+                    SerializerFeatures.CategoryScalar | SerializerFeatures.WireTypeVarint, features);
+                return true;
+            }
+
+            bool primaryReference = effective == typeof(string) || effective == typeof(byte[])
+                || effective == typeof(Uri) || effective == typeof(Type);
+            if (!effective.IsValueType && !primaryReference)
+            {
+                // Ordinary contracts use authoritative object serialization. Custom ref-struct service bridges
+                // are unsupported here and must retain their original map provider path.
+                var meta = model[effective];
+                if (meta.SerializerType is not null || meta.HasSurrogate || meta.IsAutoTuple) return false;
+                var contract = meta.Serializer;
+                if (contract.Features.GetCategory() != SerializerFeatures.CategoryMessage) return false;
+                slot = new RuntimeMapSlot(type, contract, contract.Features, features);
+                return true;
+            }
+            var node = ValueMember.TryGetCoreSerializer(model, format, compatibility, effective,
+                out WireType wireType, false, false, false, false);
+            SerializerFeatures serializerFeatures;
+            if (node is null)
+            {
+                // Existing external/surrogate metadata is authoritative. Do not bypass it on failure.
+                var meta = model[effective];
+                if (nullable && meta.SerializerType is not null
+                    && !ExternalSerializerFactories.IsRegistered(meta.SerializerType, effective))
+                {
+                    return false;
+                }
+                IProtoTypeSerializer contract = meta.Serializer;
+                if (nullable && contract is IExternalSerializer external)
+                {
+                    IProtoTypeSerializer supplied = ExternalSerializerFactories.TryCreateNullable(
+                        meta.SerializerType, type, external.Service);
+                    if (supplied is not null)
+                    {
+                        contract = supplied;
+                    }
+                }
+                node = contract;
+                serializerFeatures = contract.Features;
+            }
+            else
+            {
+                if (effective == typeof(Uri)) node = new UriDecorator(node);
+                serializerFeatures = GetDefaultWireType(effective, wireType).AsFeatures() | SerializerFeatures.CategoryScalar;
+            }
+            slot = new RuntimeMapSlot(type, node, serializerFeatures, features);
+            return true;
+        }
+
+        private static WireType GetDefaultWireType(Type type, WireType memberWireType)
+        {
+            if (type == typeof(Guid) || type == typeof(TimeSpan)) return WireType.String;
+            if (type == typeof(IntPtr) || type == typeof(UIntPtr)) return WireType.Varint;
+            return Type.GetTypeCode(type) switch
+            {
+                TypeCode.Boolean => WireType.Varint,
+                TypeCode.Byte => WireType.Varint,
+                TypeCode.SByte => WireType.Varint,
+                TypeCode.Int16 => WireType.Varint,
+                TypeCode.UInt16 => WireType.Varint,
+                TypeCode.Int32 => WireType.Varint,
+                TypeCode.UInt32 => WireType.Varint,
+                TypeCode.Int64 => WireType.Varint,
+                TypeCode.UInt64 => WireType.Varint,
+                TypeCode.Char => WireType.Varint,
+                TypeCode.DateTime => WireType.String,
+                _ => memberWireType,
+            };
+        }
+
+        public object Read(ref ProtoReader.State state, object value)
+        {
+            return node.Read(ref state, node.RequiresOldValue ? value : null);
+        }
+
+        public void Write(ref ProtoWriter.State state, object value)
+        {
+            node.Write(ref state, value);
+        }
+
+        internal object ReadSlot(ref ProtoReader.State state, object value)
+        {
+            var features = SlotFeatures;
+            if (!features.HasAny(SerializerFeatures.OptionWrappedValue))
+                return state.ReadAny(features, value, this);
+            ProtoWriter.State.AssertWrappedAndGetWireType(ref features, out bool fieldPresence);
+            var token = state.StartSubItem();
+            int field;
+            while (0 < (field = state.ReadFieldHeader()))
+            {
+                if (field == TypeModel.ListItemTag) value = state.ReadAny(features, value, this);
+                else state.SkipField();
+            }
+            state.EndSubItem(token);
+            return !fieldPresence && value is null ? TypeHelper.CreateNonTrivialDefault(type) : value;
+        }
+
+        internal object DefaultValue()
+        {
+            if (Nullable.GetUnderlyingType(type) is not null) return null;
+            if (type.IsValueType) return BclHelpers.GetUninitializedObject(type);
+            return null;
+        }
+
+        internal object CompleteMissing(ISerializationContext context, object value)
+        {
+            if (value is not null || type.IsValueType || SlotFeatures.HasAny(SerializerFeatures.OptionWrappedValue)) return value;
+            if (Features.GetCategory() == SerializerFeatures.CategoryMessage)
+            {
+                var state = ProtoReader.State.Create(default(ReadOnlyMemory<byte>), context?.Model, context?.UserState);
+                try { return Read(ref state, null); }
+                finally { state.Dispose(); }
+            }
+            // Mirror original primary factory and failure semantics, rather than treating unknown references as null.
+            if (type == typeof(string)) return TypeModel.CreateInstance<string>(context);
+            if (type == typeof(byte[])) return TypeModel.CreateInstance<byte[]>(context);
+            if (type == typeof(Uri)) return TypeModel.CreateInstance<Uri>(context);
+            if (type == typeof(Type)) return TypeModel.CreateInstance<Type>(context);
+            if (node is IProtoTypeSerializer contract && contract.CanCreateInstance())
+            {
+                value = contract.CreateInstance(context);
+                if (value is not null) return value;
+            }
+            // Unknown scalar reference factories require an authoritative typed production bridge.
+            throw new NotSupportedException("Runtime map scalar reference default factory requires a typed provider bridge.");
+        }
+
+        internal void WriteSlot(ref ProtoWriter.State state, int fieldNumber, object value)
+        {
+            var features = SlotFeatures;
+            if (!features.HasAny(SerializerFeatures.OptionWrappedValue))
+            {
+                state.WriteAny(fieldNumber, features, value, this);
+                return;
+            }
+            var wireType = ProtoWriter.State.AssertWrappedAndGetWireType(ref features, out bool fieldPresence);
+            bool isNull = value is null && (!type.IsValueType || Nullable.GetUnderlyingType(type) is not null);
+            if (isNull && !fieldPresence) return;
+            state.WriteFieldHeader(fieldNumber, wireType);
+#pragma warning disable CS0618 // Match existing nongeneric wrapped-item state operations.
+            bool writeInner = !isNull && (fieldPresence || HasNonTrivialValue(value));
+            var token = state.StartSubItem(writeInner && !type.IsValueType && features.ApplyRecursionCheck() ? value : null);
+            if (writeInner) state.WriteAny(TypeModel.ListItemTag, features, value, this);
+            state.EndSubItem(token);
+#pragma warning restore CS0618
+        }
+
+        internal bool ShouldWrite(object value)
+        {
+            return Nullable.GetUnderlyingType(type) is not null ? value is not null : HasNonTrivialValue(value);
+        }
+
+        private bool HasNonTrivialValue(object value)
+        {
+            Type type = Nullable.GetUnderlyingType(this.type) ?? this.type;
+            if (type.IsEnum) return value is not null;
+            // Reuse the original concrete primary checkers, including special reference policies.
+            if (type == typeof(byte[])) return Check<byte[]>(value);
+            if (type == typeof(Uri)) return Check<Uri>(value);
+            if (type == typeof(Type)) return Check<Type>(value);
+            if (type == typeof(Guid)) return Check<Guid>(value);
+            if (type == typeof(TimeSpan)) return Check<TimeSpan>(value);
+            if (type == typeof(IntPtr)) return Check<IntPtr>(value);
+            if (type == typeof(UIntPtr)) return Check<UIntPtr>(value);
+            if (type == typeof(ArraySegment<byte>)) return Check<ArraySegment<byte>>(value);
+            if (type == typeof(Memory<byte>)) return Check<Memory<byte>>(value);
+            if (type == typeof(ReadOnlyMemory<byte>)) return Check<ReadOnlyMemory<byte>>(value);
+            return Type.GetTypeCode(type) switch
+            {
+                TypeCode.Boolean => Check<bool>(value),
+                TypeCode.Byte => Check<byte>(value),
+                TypeCode.SByte => Check<sbyte>(value),
+                TypeCode.Int16 => Check<short>(value),
+                TypeCode.UInt16 => Check<ushort>(value),
+                TypeCode.Int32 => Check<int>(value),
+                TypeCode.UInt32 => Check<uint>(value),
