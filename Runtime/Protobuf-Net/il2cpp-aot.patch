+                AsReference = asReference,
+                AsReferenceHasValue = asReferenceHasValue,
+                DynamicType = dynamicType,
+#endif
+                DataFormat = dataFormat,
+                IsPacked = isPacked,
+                OverwriteList = overwriteList,
+                IsRequired = isRequired,
