+// MIT License - Copyright (c) 2026 wallstop
+// Full license text: https://github.com/wallstop/unity-helpers/blob/main/LICENSE
+
+namespace ProtoBuf.Serializers
+{
+    using System;
+    using System.IO;
+    using ProtoBuf.Internal.Serializers;
+    using ProtoBuf.Meta;
+
+    /// <summary>Encodes the existing keys, values and optional nullable-presence root fields through typed array operations.</summary>
+    public abstract class CollectionWrapperSerializer<TCollection, TKey, TValue>
+        : CollectionWrapperSerializer
+        where TCollection : class
+    {
+        internal override Type CollectionType => typeof(TCollection);
+
+        private static bool TryResolveSlots(
+            RuntimeTypeModel model,
+            out RuntimeCollectionItemSerializer<TKey> key,
+            out RuntimeCollectionItemSerializer<TValue> value
+        )
+        {
+            key = null;
+            value = null;
+            if (
+                !RuntimeMapSlot.TryCreate(
+                    model,
+                    typeof(TKey),
+                    default,
+                    model.DefaultCompatibilityLevel,
+                    DataFormat.Default,
+                    out RuntimeMapSlot keySlot
+                )
+                || !RuntimeMapSlot.TryCreate(
+                    model,
+                    typeof(TValue),
+                    default,
+                    model.DefaultCompatibilityLevel,
+                    DataFormat.Default,
+                    out RuntimeMapSlot valueSlot
+                )
+            )
+            {
+                return false;
+            }
+            key = new RuntimeCollectionItemSerializer<TKey>(keySlot);
+            value = new RuntimeCollectionItemSerializer<TValue>(valueSlot);
+            return true;
+        }
+
+        /// <summary>Prepares typed arrays and optional nullable presence data for the owned collection.</summary>
+        protected abstract void Prepare(
+            TCollection collection,
+            out TKey[] keys,
+            out TValue[] values,
+            out byte[] presence
+        );
+        /// <summary>Restores an owned collection from validated typed arrays and optional presence data.</summary>
+        protected abstract TCollection Restore(TKey[] keys, TValue[] values, byte[] presence);
+
+        internal override bool TryWrite(
+            RuntimeTypeModel model,
+            Stream destination,
+            object collection
+        )
+        {
+            if (
+                !TryResolveSlots(
+                    model,
+                    out RuntimeCollectionItemSerializer<TKey> key,
+                    out RuntimeCollectionItemSerializer<TValue> value
+                )
+            )
+            {
+                return false;
+            }
+            Prepare(
+                (TCollection)collection,
+                out TKey[] keys,
+                out TValue[] values,
+                out byte[] presence
+            );
+            ProtoWriter.State state = ProtoWriter.State.Create(destination, model);
+            try
+            {
+                RepeatedSerializer
+                    .CreateVector<TKey>()
+                    .WriteRepeated(
+                        ref state,
+                        1,
+                        SerializerFeatures.OptionPackedDisabled,
+                        keys,
+                        key
+                    );
+                RepeatedSerializer
+                    .CreateVector<TValue>()
+                    .WriteRepeated(
+                        ref state,
+                        2,
+                        SerializerFeatures.OptionPackedDisabled,
+                        values,
+                        value
+                    );
+                if (presence != null && 0 < presence.Length)
+                {
+                    state.WriteFieldHeader(3, WireType.String);
+                    state.WriteBytes(presence);
+                }
+                state.Close();
+                return true;
+            }
+            finally
+            {
+                state.Dispose();
+            }
+        }
+
+        internal override bool TryRead(RuntimeTypeModel model, Stream source, out object collection)
+        {
+            collection = null;
+            if (
+                !TryResolveSlots(
+                    model,
+                    out RuntimeCollectionItemSerializer<TKey> key,
+                    out RuntimeCollectionItemSerializer<TValue> value
+                )
+            )
+            {
+                return false;
+            }
+            TKey[] keys = null;
+            TValue[] values = null;
+            byte[] presence = null;
+            ProtoReader.State state = ProtoReader.State.Create(source, model);
+            try
+            {
+                int field;
+                while (0 < (field = state.ReadFieldHeader()))
+                {
+                    switch (field)
+                    {
+                        case 1:
+                            keys = RepeatedSerializer
+                                .CreateVector<TKey>()
+                                .ReadRepeated(
+                                    ref state,
+                                    SerializerFeatures.OptionClearCollection,
+                                    keys,
+                                    key
+                                );
+                            break;
+                        case 2:
+                            values = RepeatedSerializer
+                                .CreateVector<TValue>()
+                                .ReadRepeated(
+                                    ref state,
+                                    SerializerFeatures.OptionClearCollection,
+                                    values,
+                                    value
+                                );
+                            break;
+                        case 3:
+                            presence = state.AppendBytes((byte[])null);
+                            break;
+                        default:
+                            state.SkipField();
+                            break;
+                    }
+                }
+                collection = Restore(keys, values, presence);
+                return true;
+            }
+            finally
+            {
+                state.Dispose();
+            }
+        }
+    }
+}
