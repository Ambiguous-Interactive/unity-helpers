+            {
+                return Features<short?>();
+            }
+            if (type == typeof(char?))
+            {
+                return Features<char?>();
+            }
+            if (type == typeof(IntPtr?))
+            {
+                return Features<IntPtr?>();
+            }
+            if (type == typeof(UIntPtr?))
+            {
+                return Features<UIntPtr?>();
+            }
+            if (type == typeof(decimal?))
+            {
+                return Features<decimal?>();
+            }
+            if (type == typeof(Guid?))
+            {
+                return Features<Guid?>();
+            }
+            if (type == typeof(DateTime?))
+            {
+                return Features<DateTime?>();
+            }
+            if (type == typeof(TimeSpan?))
+            {
+                return Features<TimeSpan?>();
+            }
+#if NET6_0_OR_GREATER
+            if (type == typeof(DateOnly))
+            {
+                return Features<DateOnly>();
+            }
+            if (type == typeof(TimeOnly))
+            {
+                return Features<TimeOnly>();
+            }
+            if (type == typeof(DateOnly?))
+            {
+                return Features<DateOnly?>();
+            }
+            if (type == typeof(TimeOnly?))
+            {
+                return Features<TimeOnly?>();
+            }
+#endif
+            // Preserve the original unsupported-primary error path, including its inner exception.
+            return ExternalSerializer.Create(type, typeof(PrimaryTypeProvider)).Features;
+        }
+
+        private static SerializerFeatures Features<T>()
+        {
+            return SerializerCache<PrimaryTypeProvider, T>.InstanceField.Features;
+        }
+    }
+}
