+            var method = typeof(SerializerCache).GetMethod(nameof(SerializerCache.Get)).MakeGenericMethod(serviceType, genericT);
+            il.EmitCall(OpCodes.Call, method, null);
+            il.Emit(OpCodes.Ret);
