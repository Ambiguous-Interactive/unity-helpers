+// MIT License - Copyright (c) 2026 wallstop
+// Full license text: https://github.com/wallstop/unity-helpers/blob/main/LICENSE
+
+namespace ProtoBuf.Internal.Serializers
+{
+    using ProtoBuf.Serializers;
+
+    internal sealed class NullableContractSerializer<TNullable> : ISerializer<TNullable>
+    {
+        private readonly IProtoTypeSerializer contract;
+
+        internal NullableContractSerializer(IProtoTypeSerializer contract)
+        {
+            this.contract = contract;
+        }
+
+        public SerializerFeatures Features => contract.Features;
+
+        public TNullable Read(ref ProtoReader.State state, TNullable value)
+        {
+            return TypeHelper<TNullable>.FromObject(contract.Read(ref state, value));
+        }
+
+        public void Write(ref ProtoWriter.State state, TNullable value)
+        {
+            if (!TypeHelper<TNullable>.ValueChecker.IsNull(value))
+            {
+                contract.Write(ref state, value);
+            }
+        }
+    }
+}
