+
+    internal static class PrimarySerializerFeatures
+    {
+        internal static SerializerFeatures Get(Type type)
+        {
+            if (type == typeof(string))
+            {
+                return Features<string>();
+            }
+            if (type == typeof(int))
+            {
+                return Features<int>();
+            }
+            if (type == typeof(long))
+            {
+                return Features<long>();
+            }
+            if (type == typeof(bool))
+            {
+                return Features<bool>();
+            }
+            if (type == typeof(float))
+            {
+                return Features<float>();
+            }
+            if (type == typeof(double))
+            {
+                return Features<double>();
+            }
+            if (type == typeof(byte[]))
+            {
+                return Features<byte[]>();
+            }
+            if (type == typeof(ArraySegment<byte>))
+            {
+                return Features<ArraySegment<byte>>();
+            }
+            if (type == typeof(Memory<byte>))
+            {
+                return Features<Memory<byte>>();
+            }
+            if (type == typeof(ReadOnlyMemory<byte>))
+            {
+                return Features<ReadOnlyMemory<byte>>();
+            }
+            if (type == typeof(byte))
+            {
+                return Features<byte>();
+            }
+            if (type == typeof(ushort))
+            {
+                return Features<ushort>();
+            }
+            if (type == typeof(uint))
+            {
+                return Features<uint>();
+            }
+            if (type == typeof(ulong))
+            {
+                return Features<ulong>();
+            }
+            if (type == typeof(sbyte))
+            {
+                return Features<sbyte>();
+            }
+            if (type == typeof(short))
+            {
+                return Features<short>();
+            }
+            if (type == typeof(char))
+            {
+                return Features<char>();
+            }
