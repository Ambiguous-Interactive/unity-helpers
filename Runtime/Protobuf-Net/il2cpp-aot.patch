+        /// <summary>Resolve a service relative to T</summary>
+        protected override ISerializer<T> GetSerializer<T>()
+            => GetServices<T>(default) as ISerializer<T>;
+
+        internal override ISerializer<T> GetSerializerCore<T>(CompatibilityLevel ambient)
+            => GetServices<T>(ambient) as ISerializer<T>;
+
+        /// <summary>Indicates whether a type is known to the model</summary>
+        internal override bool IsKnownType<T>(CompatibilityLevel ambient) // the point of this override is to avoid loops
+                                                                          // when trying to *build* a model; we don't actually need the service (which may not exist yet);
+                                                                          // we just need to know whether we should *expect one*
+            => _serviceCache[typeof(T)] is not null || FindOrAddAuto(typeof(T), false, true, false, ambient) >= 0;
+
+        [MethodImpl(MethodImplOptions.AggressiveInlining)]
+        private object GetServices<T>(CompatibilityLevel ambient)
+        {
+            object service = _serviceCache[typeof(T)] ?? GetServicesSlow(typeof(T), ambient);
+            if (service is ISerializer<T>) return service;
+            if (service is RuntimeMapSerializer runtimeMap && runtimeMap.CollectionType == typeof(T))
+            {
+                ISerializer<T> typedMap = new RuntimeMapBoundary<T>(runtimeMap);
+                lock (_serviceCache)
+                {
+                    if (_serviceCache[typeof(T)] is ISerializer<T> existing) return existing;
+                    _serviceCache[typeof(T)] = typedMap;
+                }
+                return typedMap;
+            }
+            Type underlying = Nullable.GetUnderlyingType(typeof(T));
+            if (underlying is not null && !underlying.IsEnum)
+            {
+                IProtoTypeSerializer contract = service as IProtoTypeSerializer;
+                if (contract is null)
+                {
+                    int index = FindOrAddAuto(underlying, false, true, false, ambient);
+                    if (index >= 0) contract = ((MetaType)types[index]).Serializer;
+                }
+                if (contract is null || contract.ExpectedType != underlying) return service;
+                ISerializer<T> nullable = new NullableContractSerializer<T>(contract);
+                lock (_serviceCache)
+                {
+                    if (_serviceCache[typeof(T)] is ISerializer<T> existing) return existing;
+                    _serviceCache[typeof(T)] = nullable;
+                }
+                return nullable;
+            }
+            if (service is RuntimeTypeSerializer runtimeContract && runtimeContract.ExpectedType == typeof(T))
+            {
+                ISerializer<T> typed = new RuntimeContractSerializer<T>(runtimeContract);
+                lock (_serviceCache)
+                {
+                    if (_serviceCache[typeof(T)] is ISerializer<T> existing) return existing;
+                    _serviceCache[typeof(T)] = typed;
+                }
+                return typed;
+            }
+            if (service is SurrogateSerializer surrogate && surrogate.ExpectedType == typeof(T))
+            {
+                ISerializer<T> typed = new SurrogateSerializer<T>(surrogate);
+                lock (_serviceCache)
+                {
+                    if (_serviceCache[typeof(T)] is ISerializer<T> existing) return existing;
+                    _serviceCache[typeof(T)] = typed;
+                }
+                return typed;
+            }
+            return service;
+        }
