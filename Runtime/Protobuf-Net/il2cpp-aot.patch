+namespace ProtoBuf.Serializers
+{
+    using System.Collections.Generic;
+    using System.Runtime.CompilerServices;
+    using ProtoBuf.Meta;
+
+    /// <summary>Retains an explicit dictionary codec while using runtime enum items for its real enum slots.</summary>
+    public sealed class RuntimeEnumDictionarySerializer<TCollection, TKey, TValue>
+        : IRepeatedSerializer<TCollection>,
+            IFactory<TCollection>
+        where TCollection : IDictionary<TKey, TValue>
+    {
+        private static readonly ConditionalWeakTable<
+            MapSerializer<TCollection, TKey, TValue>,
+            RuntimeEnumDictionarySerializer<TCollection, TKey, TValue>
+        > s_instances =
+            new ConditionalWeakTable<
+                MapSerializer<TCollection, TKey, TValue>,
+                RuntimeEnumDictionarySerializer<TCollection, TKey, TValue>
+            >();
+        private static readonly ConditionalWeakTable<
+            MapSerializer<TCollection, TKey, TValue>,
+            RuntimeEnumDictionarySerializer<TCollection, TKey, TValue>
+        >.CreateValueCallback s_create = Create;
+
+        /// <inheritdoc/>
+        public SerializerFeatures Features => ((ISerializer<TCollection>)_original).Features;
+
+        private readonly MapSerializer<TCollection, TKey, TValue> _original;
+
+        /// <summary>Adapts only enum slots; all other item resolution stays with the supplied codec and model.</summary>
+        public RuntimeEnumDictionarySerializer(MapSerializer<TCollection, TKey, TValue> original)
+        {
+            _original = original;
+        }
+
+        /// <summary>Reuses the stateless adapter for the same exact codec instance; null retains optional codec resolution.</summary>
+        public static RuntimeEnumDictionarySerializer<TCollection, TKey, TValue> Get(
+            MapSerializer<TCollection, TKey, TValue> original
+        )
+        {
+            if (original is null)
+                return null;
+            return s_instances.GetValue(original, s_create);
+        }
+
+        private static RuntimeEnumDictionarySerializer<TCollection, TKey, TValue> Create(
+            MapSerializer<TCollection, TKey, TValue> original
+        )
+        {
+            return new RuntimeEnumDictionarySerializer<TCollection, TKey, TValue>(original);
+        }
+
+        /// <inheritdoc/>
+        public TCollection Create(ISerializationContext context)
+        {
+            return ((IFactory<TCollection>)_original).Create(context);
+        }
+
+        /// <inheritdoc/>
+        public TCollection Read(ref ProtoReader.State state, TCollection value)
+        {
+            return ((ISerializer<TCollection>)_original).Read(ref state, value);
+        }
+
+        /// <inheritdoc/>
+        public void Write(ref ProtoWriter.State state, TCollection value)
+        {
+            ((ISerializer<TCollection>)_original).Write(ref state, value);
+        }
+
+        /// <inheritdoc/>
+        public TCollection ReadRepeated(
+            ref ProtoReader.State state,
+            SerializerFeatures features,
+            TCollection value
+        )
+        {
+            RuntimeTypeModel model = state.Model as RuntimeTypeModel;
+            return _original.ReadMap(
+                ref state,
+                features,
+                value,
+                default,
+                default,
+                model is null ? null : model.GetRuntimeDictionaryEnumItem<TKey>(),
+                model is null ? null : model.GetRuntimeDictionaryEnumItem<TValue>()
+            );
+        }
+
+        /// <inheritdoc/>
+        public void WriteRepeated(
+            ref ProtoWriter.State state,
+            int fieldNumber,
+            SerializerFeatures features,
+            TCollection value
+        )
+        {
+            RuntimeTypeModel model = state.Model as RuntimeTypeModel;
+            _original.WriteMap(
+                ref state,
+                fieldNumber,
+                features,
+                value,
+                default,
+                default,
+                model is null ? null : model.GetRuntimeDictionaryEnumItem<TKey>(),
+                model is null ? null : model.GetRuntimeDictionaryEnumItem<TValue>()
+            );
+        }
+    }
