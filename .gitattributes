###############################################################################
# Line endings
#
# Enforce CRLF in the working tree for all text files to align with
# .editorconfig (end_of_line = crlf, charset = utf-8 without BOM) and avoid
# formatter diffs on Linux runners.
###############################################################################
* text=auto eol=crlf

# Be explicit for common text file types in this repo
*.cs        text eol=crlf
*.csproj    text eol=crlf
*.sln       text eol=crlf
*.json      text eol=crlf
*.yaml      text eol=lf
*.yml       text eol=lf
*.md        text eol=lf
*.xml       text eol=crlf
*.uxml      text eol=crlf
*.uss       text eol=crlf
*.shader    text eol=crlf
*.hlsl      text eol=crlf
*.compute   text eol=crlf
*.cginc     text eol=crlf
*.asmdef    text eol=crlf
*.asmref    text eol=crlf
*.meta      text eol=crlf
*.ps1       text eol=crlf

# Shell scripts and git hooks MUST have LF line endings (Unix requirement)
*.sh        text eol=lf
.githooks/* text eol=lf

# GitHub-specific files MUST have LF line endings
# - GitHub Actions run on Linux (LF is native)
# - Dependabot commits with LF line endings
# - This prevents line-ending diffs from dependabot PRs
.github/**  text=auto eol=lf

# npm package files MUST have LF line endings
# - Dependabot updates npm dependencies and commits with LF
package.json      text eol=lf
package-lock.json text eol=lf

# Jekyll includes MUST have LF line endings (GitHub Pages runs on Linux)
_includes/*.html  text eol=lf

###############################################################################
