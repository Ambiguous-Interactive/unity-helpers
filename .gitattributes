# Store text as LF in Git and use the repository's CRLF default on checkout.
* text=auto eol=crlf

# Text formats with a defined CRLF working-tree convention.
*.cs      text eol=crlf
*.csproj  text eol=crlf
*.sln     text eol=crlf
*.json    text eol=crlf
*.xml     text eol=crlf
*.uxml    text eol=crlf
*.uss     text eol=crlf
*.shader  text eol=crlf
*.hlsl    text eol=crlf
*.compute text eol=crlf
*.cginc   text eol=crlf
*.asmdef  text eol=crlf
*.asmref  text eol=crlf
*.meta    text eol=crlf
*.ps1     text eol=crlf

# These files must retain LF on every platform.
*.yaml                 text eol=lf
*.yml                  text eol=lf
*.md                   text eol=lf
*.sh                   text eol=lf
.githooks/**           text eol=lf
.github/**             text=auto eol=lf
package.json           text eol=lf
package-lock.json      text eol=lf
_includes/*.html       text eol=lf

# Preserve binary bytes and suppress text diffs regardless of file contents.
*.png          binary
*.gif          binary
*.jpg          binary
*.jpeg         binary
*.bmp          binary
*.tga          binary
*.psd          binary
*.tif          binary
*.tiff         binary
*.exr          binary
*.webp         binary
*.ico          binary
*.dll          binary
*.pdb          binary
*.so           binary
*.dylib        binary
*.exe          binary
*.a            binary
*.lib          binary
*.ttf          binary
*.otf          binary
*.woff         binary
*.woff2        binary
*.mp3          binary
*.ogg          binary
*.wav          binary
*.mp4          binary
*.mov          binary
*.webm         binary
*.zip          binary
*.7z           binary
*.gz           binary
*.unitypackage binary
*.fbx          binary
*.blend        binary
