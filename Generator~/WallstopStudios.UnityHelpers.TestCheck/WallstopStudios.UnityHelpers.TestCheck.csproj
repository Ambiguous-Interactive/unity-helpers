<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../UnityReferenceAssemblies.props" />
  <!--
    A LOCAL TYPE-CHECKER for the package's PlayMode test sources (#404).

    Why this exists. `typecheck:unity` compiles `Runtime/**` and stops there, so a broken fixture:
    a call to a constructor that is private, an argument that moved, a helper that was renamed, stays
    invisible until a Unity leg has spun up, restored a project, and compiled it. That is roughly
    fifty minutes to learn about a missing overload. It is not hypothetical: this project was written
    after `new Deque&lt;int&gt;()` reached a fixture, whose parameterless constructor is private.

    The sources are compiled into ONE assembly with the runtime's own name, which is what makes the
    tests' `internal` access resolve without reproducing the package's InternalsVisibleTo graph. It
    is a type-checker, not a test runner. Nothing here executes, and a green build says only that the
    fixtures compile.

    WHAT IT DOES NOT COVER, deliberately:

      1. Everything `typecheck:unity` excludes, for the same reasons (uGUI, the DI integrations),
         and the four fixtures that drive them: EnhancedImageTests, the two
         MatchColliderToSprite fixtures and UnityExtensionsComprehensiveTests.
      2. Editor tests. They need UnityEditor, which the reference assemblies do not carry.
      3. The test framework's BEHAVIOUR. `UnityEngine.TestTools` ships with Unity's test framework
         package and has no NuGet equivalent, so `Shims/` declares the handful of members these
         fixtures use: enough to bind a call, and nothing more.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- The runtime's own name: the test sources are `internal`-visible to it by being it. -->
    <AssemblyName>WallstopStudios.UnityHelpers</AssemblyName>
    <RootNamespace>WallstopStudios.UnityHelpers</RootNamespace>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../..'))</RepoRoot>
    <WallstopProto Condition="'$(WallstopProto)' == ''">true</WallstopProto>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Unity defines this in every test assembly, and the package gates test-only internals on it
         (SingletonAutoLoader.ExecuteEntriesForTests, Helpers.LayerNameProvider, the concave-hull
         diagnostics). Without it the fixtures that drive them do not bind. -->
    <DefineConstants>$(DefineConstants);UNITY_INCLUDE_TESTS</DefineConstants>
    <NoWarn>$(NoWarn);CS0414;CS0649;CS0219;CS0618;CS0612;CS0436;CS1701</NoWarn>
    <DefineConstants Condition="'$(WallstopProto)' == 'true'"
      >$(DefineConstants);WALLSTOP_PROTO</DefineConstants>
    <!-- See the TypeCheck project for why this exists (#347). The PlayMode fixtures behind the Odin
         define derive from the same two base classes the runtime aliases, so the same shim serves
         them; the editor-side drawer surface is EditorCheck's, not this project's. -->
    <WallstopOdin Condition="'$(WallstopOdin)' == ''">false</WallstopOdin>
    <DefineConstants Condition="'$(WallstopOdin)' == 'true'"
      >$(DefineConstants);WALLSTOP_UNITY_HELPERS_ODIN_INSPECTOR</DefineConstants>
    <!--
      SINGLE_THREADED is the same shape of switch as the Odin one and was unguarded the same way
      (#533). It changes declarations, not just call sites: `ReflectionHelpers` alone swaps five
      caches between `ConcurrentDictionary` and `Dictionary` under it, each with a differently-shaped
      cached getter. CI runs two SINGLE_THREADED legs, so a cache added without the matching branch
      compiled clean everywhere locally and cost a full matrix run to discover.
    -->
    <WallstopSingleThreaded Condition="'$(WallstopSingleThreaded)' == ''"
      >false</WallstopSingleThreaded>
    <DefineConstants Condition="'$(WallstopSingleThreaded)' == 'true'"
      >$(DefineConstants);SINGLE_THREADED</DefineConstants>
    <!--
      The switch the probe half of `lint:typecheck-asmdef-references` throws, and the only reason
      the three Runtime-only assemblies below can be held at all (#598).

      Unity compiles each asmdef separately; this project compiles `Runtime/**` and the PlayMode
      test tree TOGETHER, so one reference list serves trees Unity gives different ones. Every test
      asmdef sets `overrideReferences: true`, which makes its `precompiledReferences` the complete
      list its sources may bind, while `Runtime/`'s asmdef sets it false and auto-references every
      bundled plugin. An assembly only `Runtime/**` needs is therefore correct to hold here and
      invisible to Unity from a fixture. That is exactly how `JsonEncodedText.Encode` compiled
      green in all four configurations and failed the editor with 25 x CS0012.

      Setting this to false drops them, so the linter can ask the compiler the one question reading
      files cannot answer: does any fixture use them? Errors inside `Runtime/**` are expected there;
      an error in a test file is the drift.
    -->
    <WallstopRuntimeOnlyReferences Condition="'$(WallstopRuntimeOnlyReferences)' == ''"
      >true</WallstopRuntimeOnlyReferences>
  </PropertyGroup>
  <ItemGroup>
    <!-- THE VERSION UNITY SHIPS, exactly. It was 3.13.3, "the closest thing on NuGet", which
         binds every member 3.5 does and a great many it does not. Anything added to a fixture that
         exists only in the newer one compiled here with 0 errors and failed to compile in all eight
         Unity legs; `TestCaseData.SetArgDisplayNames` cost a full matrix that way (#495). A gate
         compiled against a different version of a dependency is no gate for that dependency.

         3.5.0 predates netstandard targeting, so it restores its .NET Framework assets and NuGet
         says so. That is correct here and is not a compatibility risk to fix: nothing in this project
         executes, the reference assembly is what binds a call, and it is the one Unity binds
         against. -->
    <PackageReference Include="NUnit" Version="3.5.0" NoWarn="NU1701" />
    <Analyzer Include="$(RepoRoot)/Runtime/Analyzers/WallstopStudios.UnityHelpers.Proto.Generator.dll" />
    <!-- The general-purpose WUH### analyzers ship in the same folder and Unity loads both,
         so both have to be loaded here or a local gate covers less than the editor does. -->
    <Analyzer Include="$(RepoRoot)/Runtime/Analyzers/WallstopStudios.UnityHelpers.Analyzers.dll" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="protobuf-net">
      <HintPath>$(RepoRoot)/Runtime/Protobuf-Net/protobuf-net.dll</HintPath>
    </Reference>
    <Reference Include="protobuf-net.Core">
      <HintPath>$(RepoRoot)/Runtime/Protobuf-Net/protobuf-net.Core.dll</HintPath>
    </Reference>
    <Reference Include="System.Collections.Immutable">
      <HintPath>$(RepoRoot)/Runtime/Protobuf-Net/System.Collections.Immutable.dll</HintPath>
    </Reference>
    <Reference Include="System.Text.Json">
      <HintPath>$(RepoRoot)/Runtime/Binaries/System.Text.Json.dll</HintPath>
    </Reference>
    <!--
      RUNTIME-ONLY, and switchable for that reason. No test asmdef declares these three, so nothing
      in `Tests/**` may bind them; `Runtime/**` needs all three and its asmdef auto-references them.
      Measured by dropping all three: 330 errors, every one of them in `Runtime/`. Unsafe.As and
      Unsafe.SizeOf in WProtoScalarFormatters, EnumExtensions, the R-trees and RuntimeSingleton;
      JavaScriptEncoder through JsonEncodedText.Encode's optional parameter in the JsonConverters;
      IAsyncDisposable in Serializer.cs.
    -->
    <Reference
      Include="System.Runtime.CompilerServices.Unsafe"
      Condition="'$(WallstopRuntimeOnlyReferences)' == 'true'"
    >
      <HintPath>$(RepoRoot)/Runtime/Protobuf-Net/System.Runtime.CompilerServices.Unsafe.dll</HintPath>
    </Reference>
    <Reference
      Include="System.Text.Encodings.Web"
      Condition="'$(WallstopRuntimeOnlyReferences)' == 'true'"
    >
      <HintPath>$(RepoRoot)/Runtime/Binaries/System.Text.Encodings.Web.dll</HintPath>
    </Reference>
    <Reference
      Include="Microsoft.Bcl.AsyncInterfaces"
      Condition="'$(WallstopRuntimeOnlyReferences)' == 'true'"
    >
      <HintPath>$(RepoRoot)/Runtime/Binaries/Microsoft.Bcl.AsyncInterfaces.dll</HintPath>
    </Reference>
    <!--
      `System.IO.Pipelines` was here and is deliberately gone. It is a transitive dependency of
      System.Text.Json that no source in ANY of the three trees binds: dropping it from all three
      typecheck projects compiled clean in all four define configurations. It was also declared by
      none of the test asmdefs, so holding it could only ever have hidden a CS0012 (#598).
    -->
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Shims/*.cs" />
    <!-- Same split as the TypeCheck project, and it is load-bearing rather than tidy: an
         unconditional glob compiles the Odin base classes into the define-off configurations,
         where an UNGUARDED `Sirenix.OdinInspector` reference in a fixture would then bind and
         pass. That is CS0246 in a real no-Odin Unity project, which is #275 one level down: the
         gate masking the very class it was added to catch. -->
    <Compile
      Include="../WallstopStudios.UnityHelpers.TypeCheck/Shims/*.cs"
      Exclude="../WallstopStudios.UnityHelpers.TypeCheck/Shims/OdinInspectorShim.cs"
    />
    <Compile
      Include="../WallstopStudios.UnityHelpers.TypeCheck/Shims/OdinInspectorShim.cs"
      Condition="'$(WallstopOdin)' == 'true'"
    />
    <Compile
      Include="$(RepoRoot)/Runtime/**/*.cs"
      Exclude="$(RepoRoot)/Runtime/Integrations/**/*.cs;$(RepoRoot)/Runtime/Analyzers/**/*.cs;$(RepoRoot)/Runtime/Core/Extension/Partials/UI.cs;$(RepoRoot)/Runtime/Utils/MatchColliderToSprite.cs;$(RepoRoot)/Runtime/Visuals/UGUI/EnhancedImage.cs"
    />
    <!-- `Tests/Core/Editor/**` is excluded to make the header's third exclusion TRUE rather than
         approximately true. Those four fixtures are `WallstopStudios.UnityHelpers.Tests.Core.Editor`,
         an editor-only assembly whose asmdef declares neither System.Text.Json nor the Odin
         attributes this project holds. Every one of them is `#if UNITY_EDITOR` end to end, so
         compiling them here contributed four empty namespaces and one more asmdef this project was
         quietly more permissive than (#598). -->
    <Compile
      Include="$(RepoRoot)/Tests/Core/**/*.cs"
      Exclude="$(RepoRoot)/Tests/Core/TestUtils/CiTestResultStreamLogger.cs;$(RepoRoot)/Tests/Core/Editor/**/*.cs"
    />
    <Compile
      Include="$(RepoRoot)/Tests/Runtime/**/*.cs"
      Exclude="$(RepoRoot)/Tests/Runtime/Integrations/**/*.cs;$(RepoRoot)/Tests/Runtime/Visuals/EnhancedImageTests.cs;$(RepoRoot)/Tests/Runtime/Utils/MatchColliderToSpriteTests.cs;$(RepoRoot)/Tests/Runtime/Utils/MatchColliderToSpriteAdditionalTests.cs;$(RepoRoot)/Tests/Runtime/Extensions/UnityExtensionsComprehensiveTests.cs"
    />
  </ItemGroup>
</Project>
