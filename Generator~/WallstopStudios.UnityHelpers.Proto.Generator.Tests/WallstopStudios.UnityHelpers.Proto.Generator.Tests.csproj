<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!--
      Warnings are NOT errors here, unlike everywhere else under Generator~. Two reasons, both
      about what this project compiles: its fixtures deliberately trigger the generator's own
      WPROTO diagnostics (that is the test data), and it pulls in Runtime/ sources under a net9.0
      TFM, where the .NET CA analyzers are on by default and report the inventory recorded on #378.
    -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Compiled from the repository root so the generator sees the same sources Unity does. -->
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../..'))</RepoRoot>
    <ProtobufNetOracle Condition="'$(ProtobufNetOracle)' == ''">v3</ProtobufNetOracle>
    <ProtobufNetOraclePath Condition="'$(ProtobufNetOracle)' == 'v2'"
      >$(RepoRoot)/Generator~/ProtobufNetV2Oracle/protobuf-net.dll</ProtobufNetOraclePath>
    <ProtobufNetOraclePath Condition="'$(ProtobufNetOracle)' == 'v3'"
      >$(RepoRoot)/Generator~/ProtobufNetV3Oracle/protobuf-net.dll</ProtobufNetOraclePath>
    <ProtobufNetOraclePath Condition="'$(ProtobufNetOracle)' == 'candidate'"
      >$(ProtobufNetCandidateRoot)/protobuf-net.dll</ProtobufNetOraclePath>
    <ProtobufNetCorePath>$(RepoRoot)/Generator~/ProtobufNetV3Oracle/protobuf-net.Core.dll</ProtobufNetCorePath>
    <ProtobufNetCorePath Condition="'$(ProtobufNetOracle)' == 'candidate'"
      >$(ProtobufNetCandidateRoot)/protobuf-net.Core.dll</ProtobufNetCorePath>
    <BaseOutputPath>bin/$(ProtobufNetOracle)/</BaseOutputPath>
    <IntermediateOutputPath>obj/$(ProtobufNetOracle)/$(Configuration)/</IntermediateOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
    <DefineConstants Condition="'$(ProtobufNetOracle)' == 'v2'"
      >$(DefineConstants);PROTOBUF_NET_ORACLE_V2</DefineConstants>
    <DefineConstants Condition="'$(ProtobufNetOracle)' == 'candidate'"
      >$(DefineConstants);PROTOBUF_NET_ORACLE_CANDIDATE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="WallstopStudios.UnityHelpers.SchemaConformance.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile
      Include="../../Runtime/Core/DataStructure/ValueDictionaryEnumerable.cs"
      Link="ValueDictionaryEnumerable.cs"
    />
    <Compile
      Include="../../Runtime/Core/DataStructure/ValueDictionaryEnumerator.cs"
      Link="ValueDictionaryEnumerator.cs"
    />
    <!-- The real serializer excludes Unity bootstrap and built-in Unity formatters. Signature-only
         shims keep this harness independent of Unity; native tests cover Unity behavior. -->
    <!-- Shared traits classify declared types against the local Object marker. This harness tests
         wire semantics; ObjectsTypeTraitsTests verifies the actual Unity hierarchy natively. -->
    <Compile Include="$(RepoRoot)/Runtime/Core/Helper/ObjectsTypeTraits.cs" />
    <Compile Include="$(RepoRoot)/Runtime/Core/DataStructure/ValueEnumerable.cs" />
    <Compile Include="$(RepoRoot)/Runtime/Core/DataStructure/ValueEnumerator.cs" />
    <Compile Include="$(RepoRoot)/Runtime/Core/Extension/IEnumerableExtensions.ValueEnumerable.cs" />
    <!-- The capacity limits live one directory up and are Unity-free; WProtoRectangular refuses a
         dimension through them, so the harness needs the real file rather than a stand-in. -->
    <Compile Include="$(RepoRoot)/Runtime/Core/Serialization/SerializationCapacityLimits.cs" />
    <Compile Include="$(RepoRoot)/Runtime/Core/Serialization/SerializationFailureException.cs" />
    <Compile Include="$(RepoRoot)/Tests/Runtime/Serialization/WProtoEnumFormatterTests.cs" />
    <Compile Include="$(RepoRoot)/Tests/Runtime/Serialization/WProtoReadLimitsTests.cs" />
    <Compile Include="$(RepoRoot)/Tests/Runtime/Serialization/WProtoDecodedPayloadBudgetTests.cs" />
    <Compile Include="$(RepoRoot)/Tests/Runtime/Serialization/WProtoCollectionElementBudgetTests.cs" />
    <Compile Include="$(RepoRoot)/Tests/Runtime/Serialization/WProtoContractConstructionBudgetTests.cs" />
    <Compile Include="$(RepoRoot)/Tests/Runtime/Serialization/WProtoConstructionBudgetEvents.cs" />
    <Compile Include="$(RepoRoot)/Tests/Runtime/Serialization/WProtoConstructionBudgetContract.cs" />
    <Compile Include="$(RepoRoot)/Tests/Runtime/Serialization/WProtoConstructionBudgetImmutable.cs" />
    <Compile Include="$(RepoRoot)/Tests/Runtime/Serialization/WProtoConstructionBudgetSkipped.cs" />
    <Compile Include="$(RepoRoot)/Tests/Runtime/Serialization/WProtoConstructionBudgetBase.cs" />
    <Compile Include="$(RepoRoot)/Tests/Runtime/Serialization/WProtoConstructionBudgetDerived.cs" />
    <Compile Include="$(RepoRoot)/Tests/Runtime/Serialization/WProtoConstructionBudgetValue.cs" />
    <Compile Include="$(RepoRoot)/Tests/Runtime/Serialization/WProtoConstructionBudgetSeeded.cs" />
    <Compile Include="$(RepoRoot)/Tests/Runtime/Serialization/WProtoConstructionBudgetAbstract.cs" />
    <Compile Include="$(RepoRoot)/Tests/Runtime/Serialization/WProtoConstructionBudgetConcrete.cs" />
    <Compile Include="$(RepoRoot)/Tests/Runtime/Serialization/WProtoConstructionBudgetUnseededImmutable.cs" />
    <Compile Include="$(RepoRoot)/Tests/Runtime/Serialization/WProtoCollectionBudgetContract.cs" />
    <Compile Include="$(RepoRoot)/Tests/Runtime/Serialization/WProtoCollectionBudgetSeedContract.cs" />
    <Compile Include="$(RepoRoot)/Tests/Runtime/Serialization/WProtoCollectionBudgetGenericContract.cs" />
    <Compile Include="$(RepoRoot)/Tests/Runtime/Serialization/WProtoDecodedPayloadContract.cs" />
    <Compile Include="$(RepoRoot)/Tests/Runtime/Serialization/WProtoFormatterFailureTests.cs" />
    <Compile Include="$(RepoRoot)/Tests/Runtime/Core/PairedMeasurementTests.cs" />
    <Compile Include="$(RepoRoot)/Tests/Core/BenchmarkCpuSetRecord.cs" />
    <Compile Include="$(RepoRoot)/Tests/Core/BenchmarkCpuSetTopology.cs" />
    <Compile Include="$(RepoRoot)/Tests/Core/BenchmarkProtocol.cs" />
    <Compile Include="$(RepoRoot)/Tests/Core/BenchmarkRuntimeIdentity.cs" />
    <Compile Include="$(RepoRoot)/Tests/Core/BenchmarkSlotDiagnostics.cs" />
    <Compile Include="$(RepoRoot)/Tests/Core/BenchmarkSlotObservation.cs" />
    <Compile Include="$(RepoRoot)/Tests/Core/BenchmarkThreadSnapshot.cs" />
    <Compile Include="$(RepoRoot)/Tests/Core/CalibratedBenchmarkMeasurement.cs" />
    <Compile Include="$(RepoRoot)/Tests/Core/PairedMeasurement.cs" />
    <!-- SerializableValueTuple implements it explicitly, so the file is not optional here. This
         project names its Runtime sources one by one rather than globbing, which is why a new
         dependency of one of them fails HERE and nowhere else. -->
    <Compile Include="$(RepoRoot)/Runtime/Core/DataStructure/Adapters/IUnderlyingValueProvider.cs" />
    <Compile Include="$(RepoRoot)/Runtime/Core/DataStructure/Adapters/SerializableValueTuple.cs" />
    <Compile Include="$(RepoRoot)/Runtime/Core/Serialization/WProtoValueTupleMarshalRegistrations.cs" />
    <Compile Include="$(RepoRoot)/Runtime/Core/Serialization/WProtoValueTupleMarshals.cs" />
    <!-- WProtoSchemaText is excluded on purpose: it renders schemas from attribute metadata and
         nothing here exercises it, and its presence in this assembly was measured to make
         PlannedPrefixesAvoidTheDeepLargePayloadBackpatchCost's zero-allocation assertion flaky
         (4136 stray bytes appeared between the GC markers, roughly every other full run, on this
         assembly only). The wire layer under test is byte-identical without it. -->
    <Compile
      Include="$(RepoRoot)/Runtime/Core/Serialization/WallstopProto/*.cs"
      Exclude="$(RepoRoot)/Runtime/Core/Serialization/WallstopProto/WProtoBootstrap.cs;$(RepoRoot)/Runtime/Core/Serialization/WallstopProto/WProtoBuiltInFormatters.cs;$(RepoRoot)/Runtime/Core/Serialization/WallstopProto/WProtoSchemaText.cs"
    />
    <!-- The JSON half of the AOT story. Both files are Unity-free, so the closure-to-registration
         path can be exercised end to end here: a closure written only in this assembly, the
         registrar the generator emits for it, and a real System.Text.Json round-trip through the
         registry instead of the reflective factory. -->
    <Compile Include="$(RepoRoot)/Runtime/Core/Serialization/JsonConverters/WJsonConverterAttribute.cs" />
    <Compile Include="$(RepoRoot)/Runtime/Core/Serialization/JsonConverters/WJsonConverterRegistry.cs" />
    <!-- The subtype tag assignment planner. It lives under Editor/ because assignment is an
         editor-time act, but it is deliberately free of Unity so the rules that make a committed
         field number safe (never renumber, never reuse a retired number, restore a re-added
         type's own number) can be run twice here and compared, which is the only way to prove
         determinism and idempotency at all. The Unity half that feeds it lives beside it and is
         not compiled here. -->
    <Compile Include="$(RepoRoot)/Editor/Tools/WProtoSubtypeTagPlan.cs" />
    <!-- The one value that decides whether a run may treat "I cannot see this declaration" as
         "this declaration was deleted". It is a parameter of the planner above, so the two modes
         can be compared from one fixture. -->
    <Compile Include="$(RepoRoot)/Editor/Tools/WProtoSubtypeTagDiscovery.cs" />
    <!-- Its Unity-free companion: where each assembly's manifest goes, what the committed one
         currently says, and whether assignment would change it. All three answers are decided
         without touching UnityEditor, so the defects they exist to prevent are testable here
         rather than only by launching an editor: a manifest that compiles into a different
         assembly than the one it describes, an orphaned entry silently dropped instead of
         retired, and an automatic pass that rewrites an unchanged file forever. -->
    <Compile Include="$(RepoRoot)/Editor/Tools/WProtoSubtypeTagManifestFile.cs" />
    <Compile Include="$(RepoRoot)/Runtime/Core/Helper/PathHelper.cs" />
    <Compile Include="$(RepoRoot)/Runtime/Core/Serialization/Vector4Surrogate.cs" />
    <Compile Include="$(RepoRoot)/Runtime/Core/Serialization/Matrix4x4Surrogate.cs" />
    <Compile Include="$(RepoRoot)/Runtime/Core/Serialization/KeyframeSurrogate.cs" />
    <Compile Include="$(RepoRoot)/Runtime/Core/Serialization/BoneWeightSurrogate.cs" />
    <Compile Include="$(RepoRoot)/Tests/Runtime/Serialization/WProtoExplicitDefaultContract.cs" />
    <Compile Include="$(RepoRoot)/Tests/Runtime/Serialization/WProtoExplicitDefaultTests.cs" />
    <Compile Include="$(RepoRoot)/Tests/Runtime/Serialization/WProtoNullableMapContract.cs" />
    <Compile Include="$(RepoRoot)/Tests/Runtime/Serialization/WProtoNullableMapTests.cs" />
    <Compile Include="$(RepoRoot)/Tests/Runtime/Serialization/WProtoInferredResultContract.cs" />
    <Compile Include="$(RepoRoot)/Tests/Runtime/Serialization/WProtoInferredClosureTests.cs" />
    <Compile Include="$(RepoRoot)/Tests/Core/WProtoImmutableConsumerValue.cs" />
    <Compile Include="$(RepoRoot)/Tests/Runtime/Serialization/ConsumerMigration/*.cs" />
    <Compile Include="$(RepoRoot)/Tests/Runtime/Serialization/WProtoConsumerMigrationTests.cs" />
    <Compile Include="$(RepoRoot)/Tests/ProtoOnly/WProtoBufferWriter*.cs" />
    <Compile Include="$(RepoRoot)/Tests/ProtoOnly/WProtoFaultBufferWriter.cs" />
    <Compile Include="$(RepoRoot)/Tests/ProtoOnly/IWProtoRuntimeSave.cs" />
    <Compile Include="$(RepoRoot)/Tests/ProtoOnly/WProtoRuntimeSave.cs" />
    <Compile Include="$(RepoRoot)/Tests/ProtoOnly/WProtoRuntimeOtherSave.cs" />
    <Compile Include="*.cs" />
    <Compile
      Include="$(RepoRoot)/Tests/Core/DictionaryAssertions.cs"
      Link="DictionaryAssertions.cs"
    />
  </ItemGroup>

  <ItemGroup>
    <Using Include="WallstopStudios.UnityHelpers.Tests.Core" />
  </ItemGroup>

  <ItemGroup>
    <!-- Referenced normally as well, so the diagnostic tests can drive the generator through a
         Roslyn GeneratorDriver over a synthetic consumer compilation. -->
    <ProjectReference Include="../WallstopStudios.UnityHelpers.Proto.Generator/WallstopStudios.UnityHelpers.Proto.Generator.csproj">
      <!-- Building the generator normally refreshes the shipped DLL. Not from here: these tests
           validate the shipped artifact, and a run that rewrote it first could never fail. -->
      <Properties>CopyAnalyzerPayload=false</Properties>
    </ProjectReference>
    <ProjectReference Include="../WallstopStudios.UnityHelpers.OdinMigration.Generator/WallstopStudios.UnityHelpers.OdinMigration.Generator.csproj">
      <Properties>CopyAnalyzerPayload=false</Properties>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Each process loads exactly one conformance oracle. The assemblies have the same simple
         name, so aliases in one process could silently bind both references to the same physical
         assembly. CI runs this project once per version instead. The v3 binary is the one the
         package ships; the v2 binary lives under Generator~ and never enters a Unity payload. -->
    <Reference
      Include="protobuf-net, Version=2.4.0.0, Culture=neutral, PublicKeyToken=257b51d87d2e4d67"
      Condition="'$(ProtobufNetOracle)' == 'v2'"
    >
      <HintPath>$(ProtobufNetOraclePath)</HintPath>
      <SpecificVersion>true</SpecificVersion>
    </Reference>
    <Reference
      Include="protobuf-net, Version=3.0.0.0, Culture=neutral, PublicKeyToken=257b51d87d2e4d67"
      Condition="'$(ProtobufNetOracle)' == 'v3' or '$(ProtobufNetOracle)' == 'candidate'"
    >
      <HintPath>$(ProtobufNetOraclePath)</HintPath>
      <SpecificVersion>true</SpecificVersion>
    </Reference>
    <Reference
      Include="protobuf-net.Core, Version=3.0.0.0, Culture=neutral, PublicKeyToken=257b51d87d2e4d67"
      Condition="'$(ProtobufNetOracle)' == 'v3' or '$(ProtobufNetOracle)' == 'candidate'"
    >
      <HintPath>$(ProtobufNetCorePath)</HintPath>
      <SpecificVersion>true</SpecificVersion>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(ProtobufNetOracle)' == 'candidate'">
    <PackageReference Include="System.Collections.Immutable" Version="10.0.13" />
    <None
      Include="$(ProtobufNetCandidateRoot)/candidate-receipt.json"
      CopyToOutputDirectory="Always"
    />
    <None
      Include="../ProtobufNetCurrentCandidate/il2cpp-aot.patch"
      Link="candidate-source.patch"
      CopyToOutputDirectory="Always"
    />
  </ItemGroup>

  <ItemGroup>
    <PackageReference
      Include="UnityEngine.Modules"
      Version="2021.3.33"
      GeneratePathProperty="true"
      PrivateAssets="all"
      ExcludeAssets="all"
    />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup>
    <None
      Include="$(PkgUnityEngine_Modules)/lib/netstandard2.0/*.dll"
      Link="CompatibilityReferences/%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>

  <Target Name="ValidateProtobufNetOracle" BeforeTargets="ResolveReferences">
    <Error
      Condition="'$(ProtobufNetOracle)' != 'v2' and '$(ProtobufNetOracle)' != 'v3' and '$(ProtobufNetOracle)' != 'candidate'"
      Text="Unknown ProtobufNetOracle '$(ProtobufNetOracle)'. Expected v2, v3, or candidate."
    />
    <Error
      Condition="'$(ProtobufNetOracle)' == 'candidate' and ('$(ProtobufNetCandidateRoot)' == '' or !Exists('$(ProtobufNetCandidateRoot)/candidate-receipt.json') or !Exists('$(ProtobufNetCorePath)'))"
      Text="The candidate lane requires ProtobufNetCandidateRoot with both built assemblies and candidate-receipt.json."
    />
    <Error
      Condition="!Exists('$(ProtobufNetOraclePath)')"
      Text="The $(ProtobufNetOracle) protobuf-net oracle is missing at '$(ProtobufNetOraclePath)'."
    />
  </Target>
</Project>
