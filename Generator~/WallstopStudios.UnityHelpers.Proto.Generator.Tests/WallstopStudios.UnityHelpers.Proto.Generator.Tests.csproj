<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!--
      Warnings are NOT errors here, unlike everywhere else under Generator~. Two reasons, both
      about what this project compiles: its fixtures deliberately trigger the generator's own
      WPROTO diagnostics (that is the test data), and it pulls in Runtime/ sources under a net9.0
      TFM, where the .NET CA analyzers are on by default and report the inventory recorded on #378.
    -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Compiled from the repository root so the generator sees the same sources Unity does. -->
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../..'))</RepoRoot>
    <ProtobufNetOracle Condition="'$(ProtobufNetOracle)' == ''">v3</ProtobufNetOracle>
    <ProtobufNetOraclePath Condition="'$(ProtobufNetOracle)' == 'v2'"
      >$(RepoRoot)/Generator~/ProtobufNetV2Oracle/protobuf-net.dll</ProtobufNetOraclePath>
    <ProtobufNetOraclePath Condition="'$(ProtobufNetOracle)' == 'v3'"
      >$(RepoRoot)/Runtime/Protobuf-Net/protobuf-net.dll</ProtobufNetOraclePath>
    <BaseOutputPath>bin/$(ProtobufNetOracle)/</BaseOutputPath>
    <IntermediateOutputPath>obj/$(ProtobufNetOracle)/$(Configuration)/</IntermediateOutputPath>
    <DefineConstants Condition="'$(ProtobufNetOracle)' == 'v2'"
      >$(DefineConstants);PROTOBUF_NET_ORACLE_V2</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- The real serializer, not a copy. The bootstrap is excluded because it is the one file that
         references UnityEngine, and the Unity-free compilation is exactly what makes this harness
         possible. -->
    <!-- The capacity limits live one directory up and are Unity-free; WProtoRectangular refuses a
         dimension through them, so the harness needs the real file rather than a stand-in. -->
    <Compile Include="$(RepoRoot)/Runtime/Core/Serialization/SerializationCapacityLimits.cs" />
    <Compile Include="$(RepoRoot)/Runtime/Core/DataStructure/Adapters/SerializableValueTuple.cs" />
    <Compile Include="$(RepoRoot)/Runtime/Core/Serialization/WProtoValueTupleMarshalRegistrations.cs" />
    <Compile Include="$(RepoRoot)/Runtime/Core/Serialization/WProtoValueTupleMarshals.cs" />
    <!-- WProtoSchemaText is excluded on purpose: it renders schemas from attribute metadata and
         nothing here exercises it, and its presence in this assembly was measured to make
         PlannedPrefixesAvoidTheDeepLargePayloadBackpatchCost's zero-allocation assertion flaky
         (4136 stray bytes appeared between the GC markers, roughly every other full run, on this
         assembly only). The wire layer under test is byte-identical without it. -->
    <Compile
      Include="$(RepoRoot)/Runtime/Core/Serialization/WallstopProto/*.cs"
      Exclude="$(RepoRoot)/Runtime/Core/Serialization/WallstopProto/WProtoBootstrap.cs;$(RepoRoot)/Runtime/Core/Serialization/WallstopProto/WProtoBuiltInFormatters.cs;$(RepoRoot)/Runtime/Core/Serialization/WallstopProto/WProtoSchemaText.cs"
    />
    <!-- The JSON half of the AOT story. Both files are Unity-free, so the closure-to-registration
         path can be exercised end to end here: a closure written only in this assembly, the
         registrar the generator emits for it, and a real System.Text.Json round-trip through the
         registry instead of the reflective factory. -->
    <Compile Include="$(RepoRoot)/Runtime/Core/Serialization/JsonConverters/WJsonConverterAttribute.cs" />
    <Compile Include="$(RepoRoot)/Runtime/Core/Serialization/JsonConverters/WJsonConverterRegistry.cs" />
    <!-- The subtype tag assignment planner. It lives under Editor/ because assignment is an
         editor-time act, but it is deliberately free of Unity so the rules that make a committed
         field number safe (never renumber, never reuse a retired number, restore a re-added
         type's own number) can be run twice here and compared, which is the only way to prove
         determinism and idempotency at all. The Unity half that feeds it lives beside it and is
         not compiled here. -->
    <Compile Include="$(RepoRoot)/Editor/Tools/WProtoSubtypeTagPlan.cs" />
    <!-- Its Unity-free companion: where each assembly's manifest goes, what the committed one
         currently says, and whether assignment would change it. All three answers are decided
         without touching UnityEditor, so the defects they exist to prevent are testable here
         rather than only by launching an editor: a manifest that compiles into a different
         assembly than the one it describes, an orphaned entry silently dropped instead of
         retired, and an automatic pass that rewrites an unchanged file forever. -->
    <Compile Include="$(RepoRoot)/Editor/Tools/WProtoSubtypeTagManifestFile.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The analyzer under test is the DLL this package SHIPS, not a fresh build of the sources
         beside it. That is the only binary Unity ever loads, and pointing the suite at a rebuild
         would leave a stale committed DLL undetectable. Byte-comparing the two instead was tried
         and abandoned: the compiler hashes source file paths into the assembly, so a CI checkout
         and a developer's working copy never produce identical bytes however deterministic the
         build is. -->
    <Analyzer Include="$(RepoRoot)/Runtime/Analyzers/WallstopStudios.UnityHelpers.Proto.Generator.dll" />

    <!-- Referenced normally as well, so the diagnostic tests can drive the generator through a
         Roslyn GeneratorDriver over a synthetic consumer compilation. -->
    <ProjectReference Include="../WallstopStudios.UnityHelpers.Proto.Generator/WallstopStudios.UnityHelpers.Proto.Generator.csproj">
      <!-- Building the generator normally refreshes the shipped DLL. Not from here: these tests
           validate the shipped artifact, and a run that rewrote it first could never fail. -->
      <Properties>CopyAnalyzerPayload=false</Properties>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Each process loads exactly one conformance oracle. The assemblies have the same simple
         name, so aliases in one process could silently bind both references to the same physical
         assembly. CI runs this project once per version instead. The v3 binary is the one the
         package ships; the v2 binary lives under Generator~ and never enters a Unity payload. -->
    <Reference
      Include="protobuf-net, Version=2.4.0.0, Culture=neutral, PublicKeyToken=257b51d87d2e4d67"
      Condition="'$(ProtobufNetOracle)' == 'v2'"
    >
      <HintPath>$(ProtobufNetOraclePath)</HintPath>
      <SpecificVersion>true</SpecificVersion>
    </Reference>
    <Reference
      Include="protobuf-net, Version=3.0.0.0, Culture=neutral, PublicKeyToken=257b51d87d2e4d67"
      Condition="'$(ProtobufNetOracle)' == 'v3'"
    >
      <HintPath>$(ProtobufNetOraclePath)</HintPath>
      <SpecificVersion>true</SpecificVersion>
    </Reference>
    <Reference
      Include="protobuf-net.Core, Version=3.0.0.0, Culture=neutral, PublicKeyToken=257b51d87d2e4d67"
      Condition="'$(ProtobufNetOracle)' == 'v3'"
    >
      <HintPath>$(RepoRoot)/Runtime/Protobuf-Net/protobuf-net.Core.dll</HintPath>
      <SpecificVersion>true</SpecificVersion>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
  </ItemGroup>

  <Target Name="ValidateProtobufNetOracle" BeforeTargets="ResolveReferences">
    <Error
      Condition="'$(ProtobufNetOracle)' != 'v2' and '$(ProtobufNetOracle)' != 'v3'"
      Text="Unknown ProtobufNetOracle '$(ProtobufNetOracle)'. Expected v2 or v3."
    />
    <Error
      Condition="!Exists('$(ProtobufNetOraclePath)')"
      Text="The $(ProtobufNetOracle) protobuf-net oracle is missing at '$(ProtobufNetOraclePath)'."
    />
  </Target>
</Project>
