<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A LOCAL TYPE-CHECKER for the package's Unity-dependent runtime sources.

    Why this exists. The Unity MCP bridge is the compile gate, and it is not always available: it can
    wedge mid-session (serving stale assemblies while reporting a clean console) and it can go down
    entirely, at which point nothing in the devcontainer can restart it, because the bridge process
    runs on the Windows host. With it gone there is no local type-checker at all, and the gap has a
    specific shape: a missing `using` is SEMANTIC, so CSharpier parses the file happily and CI is the
    first thing to notice, roughly fifty minutes later.

    That is not hypothetical. Two errors reached CI this way in a single session: a missing namespace
    import on a bulk annotation edit, and a `partial` regex that did not allow `sealed`. Both are
    caught here in seconds, verified by reintroducing each one:

        missing using          =&gt; error CS0246
        non-partial contract   =&gt; error WPROTO001

    This compiles the REAL sources, not a copy, and loads the SHIPPED analyzer, so WallstopProto
    diagnostics fire exactly as they do in the editor. It is a type-checker, not a test runner: it
    proves the package compiles, and says nothing about behaviour.

    WHAT IT DOES NOT COVER, deliberately and explicitly:

      1. Three uGUI-dependent files (UI.cs, MatchColliderToSprite.cs, EnhancedImage.cs).
         UnityEngine.UI ships as a Unity package (com.unity.ugui) with no NuGet equivalent, and those
         three are UI utilities with no serialization role. `ColorBlock` IS shimmed, because
         Serializer reaches it through ColorBlockConverter.
      2. The three Integrations assemblies, each its own asmdef gated on a third-party DI package.
      3. Editor code and tests.
      4. IL2CPP. The whole point of WallstopProto is that IL2CPP fails where Mono succeeds, so a green
         build here is necessary and NOT sufficient; the standalone CI legs remain the real proof.

    The reference assemblies come from the community `UnityEngine.Modules` NuGet package rather than
    an installed editor. It is unofficial, and it is used ONLY here: this project lives under
    `Generator~`, which Unity ignores by the trailing-tilde convention, and ships to nobody.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- Unity 2021.3, the oldest version in the CI matrix, is the constraint that matters. -->
    <LangVersion>9</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>WallstopStudios.UnityHelpers.TypeCheck</AssemblyName>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../..'))</RepoRoot>
    <WallstopProto Condition="'$(WallstopProto)' == ''">true</WallstopProto>
    <!-- WyRandom uses a pointer for its state mixing. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Unassigned-field and unused-local warnings are about fields Unity assigns through the
         inspector and locals kept for readability. They are noise HERE; the real build judges them. -->
    <NoWarn>$(NoWarn);CS0414;CS0649;CS0219;CS0618;CS0612</NoWarn>
    <!--
      ErrorProne.NET.Structs is the analyzer a downstream consumer runs against this package (#512),
      so it is the one that decides whether a signature costs them a warning they cannot fix.

      Only EPS01 is escalated, and only because it is at ZERO and is the root of the family: a
      `readonly struct` cannot produce a hidden copy at all, so refusing a new struct that could have
      been readonly removes the whole class before it is written. `PooledArray<T>` and
      `PooledResource<T>` were the two it caught, and they are used ~740 times.

      The rest of the family is silenced rather than baselined, because MEASURED most of it is not
      real: 42 of the 50 remaining EPS06 are `Span`/`ReadOnlySpan`, and the analyzer is simply wrong
      about them. It is NOT a reference-assembly artifact, which is what this comment claimed until
      it was checked: `UnityEngine.Modules` ships no BCL assembly at all, `Span<T>` resolves from
      Microsoft's own `NETStandard.Library.Ref` netstandard.dll, and that assembly DOES carry
      `IsReadOnlyAttribute` on both span types. `ErrorProne.NET.Structs` 0.1.2 fails to recognize
      them either way. A minimal repro flags them identically under netstandard2.1 and net9.0,
      while correctly staying silent on a source `readonly struct`, `DateTime` and `Guid`. So the
      fix is a newer analyzer, not a different reference assembly. The genuine remainder is 8 sites,
      inventoried on #517 rather than hidden here.

      Count these from SARIF (`-p:ErrorLog=x.sarif%2Cversion=2.1`), never from the console log:
      MSBuild truncates a warning message at an embedded newline, which hides exactly the 3
      `_buffer[...]` indexer sites in WProtoWriter and is why this comment used to say 39.
    -->
    <NoWarn>$(NoWarn);EPS02;EPS03;EPS04;EPS05;EPS06;EPS07;EPS08;EPS09;EPS10;EPS11;EPS12</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);EPS01</WarningsAsErrors>
    <!--
      The runtime asmdef defines WALLSTOP_PROTO through the supported Unity version, making the facade
      swap the Unity default. `npm run typecheck:unity` builds this project twice: first with that
      default, then without it to preserve the legacy protobuf-net fallback branch. Both halves ship,
      so both have to compile.
    -->
    <DefineConstants Condition="'$(WallstopProto)' == 'true'"
      >$(DefineConstants);WALLSTOP_PROTO</DefineConstants>
    <!--
      Odin Inspector changes the BASE CLASS of two public runtime types, and that branch compiled
      nowhere in automation until #347. Odin is paid and has no NuGet package, so `Shims/
      OdinInspectorShim.cs` declares the two base classes the runtime aliases and nothing else.
      `npm run typecheck:unity` builds this project a third time with it on. The editor-side Odin
      surface (nine drawers, three inspectors) is out of reach here and is therefore STILL COMPILED
      BY NOTHING: reaching it means compiling the whole Editor assembly, which needs a UnityEditor
      reference the community assemblies do not carry. Tracked on #347.
    -->
    <WallstopOdin Condition="'$(WallstopOdin)' == ''">false</WallstopOdin>
    <DefineConstants Condition="'$(WallstopOdin)' == 'true'"
      >$(DefineConstants);WALLSTOP_UNITY_HELPERS_ODIN_INSPECTOR</DefineConstants>
    <!--
      SINGLE_THREADED is the same shape of switch as the Odin one and was unguarded the same way
      (#533). It changes declarations, not just call sites: `ReflectionHelpers` alone swaps five
      caches between `ConcurrentDictionary` and `Dictionary` under it, each with a differently-shaped
      cached getter. CI runs two SINGLE_THREADED legs, so a cache added without the matching branch
      compiled clean everywhere locally and cost a full matrix run to discover.
    -->
    <WallstopSingleThreaded Condition="'$(WallstopSingleThreaded)' == ''"
      >false</WallstopSingleThreaded>
    <DefineConstants Condition="'$(WallstopSingleThreaded)' == 'true'"
      >$(DefineConstants);SINGLE_THREADED</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" />
    <!-- Analyzer only: it ships to nobody and contributes no runtime assets. -->
    <PackageReference Include="ErrorProne.NET.Structs" Version="0.1.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>analyzers</IncludeAssets>
    </PackageReference>
    <!-- The analyzer Unity actually loads, so a contract the generator refuses fails HERE. -->
    <Analyzer Include="$(RepoRoot)/Runtime/Analyzers/WallstopStudios.UnityHelpers.Proto.Generator.dll" />
    <!-- The general-purpose WUH### analyzers ship in the same folder and Unity loads both,
         so both have to be loaded here or a local gate covers less than the editor does. -->
    <Analyzer Include="$(RepoRoot)/Runtime/Analyzers/WallstopStudios.UnityHelpers.Analyzers.dll" />
    <CompilerVisibleProperty Include="WProtoDisableModuleInitializer" />
  </ItemGroup>
  <ItemGroup>
    <!-- The same vendored binaries the package ships to Unity. -->
    <Reference Include="protobuf-net">
      <HintPath>$(RepoRoot)/Runtime/Protobuf-Net/protobuf-net.dll</HintPath>
    </Reference>
    <Reference Include="protobuf-net.Core">
      <HintPath>$(RepoRoot)/Runtime/Protobuf-Net/protobuf-net.Core.dll</HintPath>
    </Reference>
    <Reference Include="System.Collections.Immutable">
      <HintPath>$(RepoRoot)/Runtime/Protobuf-Net/System.Collections.Immutable.dll</HintPath>
    </Reference>
    <Reference Include="System.Runtime.CompilerServices.Unsafe">
      <HintPath>$(RepoRoot)/Runtime/Protobuf-Net/System.Runtime.CompilerServices.Unsafe.dll</HintPath>
    </Reference>
    <Reference Include="System.Text.Json">
      <HintPath>$(RepoRoot)/Runtime/Binaries/System.Text.Json.dll</HintPath>
    </Reference>
    <Reference Include="System.Text.Encodings.Web">
      <HintPath>$(RepoRoot)/Runtime/Binaries/System.Text.Encodings.Web.dll</HintPath>
    </Reference>
    <Reference Include="System.IO.Pipelines">
      <HintPath>$(RepoRoot)/Runtime/Binaries/System.IO.Pipelines.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.Bcl.AsyncInterfaces">
      <HintPath>$(RepoRoot)/Runtime/Binaries/Microsoft.Bcl.AsyncInterfaces.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- The Odin shim is inert without the define, so it is included only where it is meaningful:
         declaring the two base classes in every configuration would compile types nothing binds. -->
    <Compile Include="Shims/*.cs" Exclude="Shims/OdinInspectorShim.cs" />
    <Compile Include="Shims/OdinInspectorShim.cs" Condition="'$(WallstopOdin)' == 'true'" />
    <!-- The main runtime asmdef's scope, minus the exclusions documented at the top. -->
    <Compile
      Include="$(RepoRoot)/Runtime/**/*.cs"
      Exclude="$(RepoRoot)/Runtime/Integrations/**/*.cs;$(RepoRoot)/Runtime/Analyzers/**/*.cs;$(RepoRoot)/Runtime/Core/Extension/Partials/UI.cs;$(RepoRoot)/Runtime/Utils/MatchColliderToSprite.cs;$(RepoRoot)/Runtime/Visuals/UGUI/EnhancedImage.cs"
    />
  </ItemGroup>
</Project>
