<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ProtobufNetOracle Condition="'$(ProtobufNetOracle)' == ''">v3</ProtobufNetOracle>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference
      Include="../WallstopStudios.UnityHelpers.Proto.Generator.Tests/WallstopStudios.UnityHelpers.Proto.Generator.Tests.csproj"
      AdditionalProperties="ProtobufNetOracle=v3"
    />
    <Reference Include="protobuf-net, Version=3.0.0.0, Culture=neutral, PublicKeyToken=257b51d87d2e4d67">
      <HintPath>../../Runtime/Protobuf-Net/protobuf-net.dll</HintPath>
      <SpecificVersion>true</SpecificVersion>
    </Reference>
    <Reference Include="protobuf-net.Core, Version=3.0.0.0, Culture=neutral, PublicKeyToken=257b51d87d2e4d67">
      <HintPath>../../Runtime/Protobuf-Net/protobuf-net.Core.dll</HintPath>
      <SpecificVersion>true</SpecificVersion>
    </Reference>
    <Compile
      Include="Captured/LevelProgressModel.cs.txt;Captured/SettingsModel.cs.txt;Captured/ProgressOracle.cs.txt;Captured/SettingsOracle.cs.txt"
      Link="Captured/%(Filename)"
    />
    <Compile
      Include="../../Tests/Runtime/Serialization/ProtoBenchmarkBufferWriter.cs"
      Link="ProtoBenchmarkBufferWriter.cs"
    />
    <None
      Update="Captured/*.cs.txt;Data/*.bin;Data/*.json.txt;DoxRetainedInventory.v1.json"
      CopyToOutputDirectory="PreserveNewest"
    />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
  <Target Name="RequireDoxV3Oracle" BeforeTargets="PrepareForBuild;ResolveProjectReferences">
    <Error
      Condition="'$(ProtobufNetOracle)' != 'v3'"
      Text="Dox retained admission requires ProtobufNetOracle=v3; v2 and mixed global configurations are unsupported."
    />
    <Error
      Condition="'$(ProtobufNetOraclePath)' != ''"
      Text="Dox retained admission uses the pinned repository v3 oracle; an external ProtobufNetOraclePath is unsupported."
    />
  </Target>
</Project>
