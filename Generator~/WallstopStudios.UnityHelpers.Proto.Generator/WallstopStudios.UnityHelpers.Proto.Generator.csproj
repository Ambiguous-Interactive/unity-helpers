<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- netstandard2.0 is what Unity's compiler loads analyzers as, on every version this package
         supports. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IsPackable>false</IsPackable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <AssemblyName>WallstopStudios.UnityHelpers.Proto.Generator</AssemblyName>
    <RootNamespace>WallstopStudios.UnityHelpers.Proto.Generator</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <!-- Determinism alone is not reproducibility: the compiler embeds source file paths, so the
         same sources built from two directories produce different bytes (measured), and it is
         what made a byte-comparing CI gate fail on its first run. ContinuousIntegrationBuild turns
         on DeterministicSourcePaths, which rewrites those paths relative to the repository root
         the SDK's built-in SourceLink discovers, so a CI checkout and a working copy agree. -->
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <!-- ...and turning that on makes SourceLink stamp the git commit into
         AssemblyInformationalVersion, so the bytes change on every commit and no comparison against
         a committed artifact can ever pass. This is the second half of the same setting. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DebugType>none</DebugType>
    <!-- Where a build drops the analyzer Unity loads. Defaulting to the shipped location means the
         committed DLL cannot silently fall behind its sources: building the project IS refreshing
         it. CI overrides this with a temporary directory so the byte comparison it makes does not
         dirty the checkout, and the test project sets CopyAnalyzerPayload=false so running tests
         never rewrites the artifact they are validating. -->
    <CopyAnalyzerPayload Condition="'$(CopyAnalyzerPayload)' == ''">true</CopyAnalyzerPayload>
    <AnalyzerPayloadOutputDir Condition="'$(AnalyzerPayloadOutputDir)' == ''"
      >$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../Runtime/Analyzers'))</AnalyzerPayloadOutputDir>
    <!-- RS2008 wants an AnalyzerReleases.*.md ledger, which is for analyzer packages published on
         NuGet with a release cadence; this generator ships inside the package it belongs to.
         RS1032 objects to the multi-clause diagnostic messages, and those messages are the whole
         point: a contract that cannot be serialized has to say what to do about it. -->
    <NoWarn>$(NoWarn);RS2008;RS1032</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- 3.8 deliberately, not 4.x. Unity 2021.3 ships Roslyn 3.9 and cannot load an analyzer built
         against 4.x at all, nor run an IIncrementalGenerator, which did not exist yet. Compiling
         against 3.8 produces an ISourceGenerator every Unity version this package supports can
         run. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="3.8.0" PrivateAssets="all" />
    <PackageReference
      Include="Microsoft.CodeAnalysis.Analyzers"
      Version="3.3.4"
      PrivateAssets="all"
    />
  </ItemGroup>

  <Target
    Name="CopyAnalyzerToPackage"
    AfterTargets="Build"
    Condition="'$(CopyAnalyzerPayload)' == 'true'"
  >
    <MakeDir
      Directories="$(AnalyzerPayloadOutputDir)"
      Condition="!Exists('$(AnalyzerPayloadOutputDir)')"
    />
    <Copy
      SourceFiles="$(TargetPath)"
      DestinationFolder="$(AnalyzerPayloadOutputDir)"
      SkipUnchangedFiles="true"
    />
    <Message Importance="high" Text="Analyzer payload -&gt; $(AnalyzerPayloadOutputDir)" />
  </Target>
</Project>
