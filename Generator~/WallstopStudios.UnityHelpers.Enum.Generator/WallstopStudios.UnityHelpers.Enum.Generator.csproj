<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IsPackable>false</IsPackable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <AssemblyName>WallstopStudios.UnityHelpers.Enum.Generator</AssemblyName>
    <RootNamespace>WallstopStudios.UnityHelpers.Enum.Generator</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DebugType>none</DebugType>
    <CopyAnalyzerPayload
      Condition="'$(CopyAnalyzerPayload)' == '' and '$(Configuration)' == 'Release'"
      >true</CopyAnalyzerPayload>
    <CopyAnalyzerPayload Condition="'$(CopyAnalyzerPayload)' == ''">false</CopyAnalyzerPayload>
    <AnalyzerPayloadOutputDir Condition="'$(AnalyzerPayloadOutputDir)' == ''"
      >$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../Runtime/Analyzers'))</AnalyzerPayloadOutputDir>
    <!-- RS2008 wants an AnalyzerReleases ledger for NuGet analyzer packages; this generator ships
         inside the package it belongs to. Keep the Unity Roslyn 3.8 source-generator API floor. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Unity 2021.3 documents Microsoft.CodeAnalysis 3.8 as the source-generator API requirement. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="3.8.0" PrivateAssets="all" />
    <PackageReference
      Include="Microsoft.CodeAnalysis.Analyzers"
      Version="3.3.4"
      PrivateAssets="all"
    />
  </ItemGroup>
  <Target
    Name="RejectNonReleaseAnalyzerPayload"
    BeforeTargets="CopyAnalyzerToPackage"
    Condition="'$(CopyAnalyzerPayload)' == 'true' and '$(Configuration)' != 'Release'"
  >
    <Error Text="Analyzer payloads can only be copied from a Release build; current configuration is '$(Configuration)'. Run dotnet build -c Release." />
  </Target>
  <Target
    Name="CopyAnalyzerToPackage"
    AfterTargets="Build"
    Condition="'$(CopyAnalyzerPayload)' == 'true'"
  >
    <MakeDir
      Directories="$(AnalyzerPayloadOutputDir)"
      Condition="!Exists('$(AnalyzerPayloadOutputDir)')"
    />
    <Copy
      SourceFiles="$(TargetPath)"
      DestinationFolder="$(AnalyzerPayloadOutputDir)"
      SkipUnchangedFiles="true"
    />
    <Message Importance="high" Text="Analyzer payload -&gt; $(AnalyzerPayloadOutputDir)" />
  </Target>
</Project>
