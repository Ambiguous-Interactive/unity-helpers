# The public Z3 5.3.3 API used by the bounded-sampling proof.

class BoolRef:
    def __bool__(self) -> bool: ...

class CheckSatResult: ...
class ModelRef: ...

class Solver:
    def __init__(self) -> None: ...
    def set(self, *, timeout: int) -> None: ...
    def add(self, *args: BoolRef) -> None: ...
    def check(self) -> CheckSatResult: ...
    def model(self) -> ModelRef: ...
    def reason_unknown(self) -> str: ...

class BitVecRef:
    def __add__(self, other: BitVecRef | int) -> BitVecRef: ...
    def __radd__(self, other: int) -> BitVecRef: ...
    def __sub__(self, other: BitVecRef | int) -> BitVecRef: ...
    def __rsub__(self, other: int) -> BitVecRef: ...
    def __mul__(self, other: BitVecRef | int) -> BitVecRef: ...
    def __rmul__(self, other: int) -> BitVecRef: ...
    def __and__(self, other: BitVecRef | int) -> BitVecRef: ...
    def __lshift__(self, other: int) -> BitVecRef: ...
    def __neg__(self) -> BitVecRef: ...
    # Z3 comparison constructs a formula rather than a Python Boolean.
    def __eq__(self, other: object) -> BoolRef: ...  # type: ignore[override] # pyright: ignore[reportIncompatibleMethodOverride]
    def __ne__(self, other: object) -> BoolRef: ...  # type: ignore[override] # pyright: ignore[reportIncompatibleMethodOverride]

class ArithRef:
    def __add__(self, other: ArithRef | int) -> ArithRef: ...
    def __radd__(self, other: int) -> ArithRef: ...
    def __sub__(self, other: ArithRef | int) -> ArithRef: ...
    def __rsub__(self, other: int) -> ArithRef: ...
    def __mul__(self, other: ArithRef | int) -> ArithRef: ...
    def __rmul__(self, other: int) -> ArithRef: ...
    def __truediv__(self, other: int) -> ArithRef: ...
    def __mod__(self, other: ArithRef) -> ArithRef: ...
    def __rmod__(self, other: int) -> ArithRef: ...
    def __lt__(self, other: ArithRef | int) -> BoolRef: ...
    def __le__(self, other: ArithRef | int) -> BoolRef: ...
    def __gt__(self, other: ArithRef | int) -> BoolRef: ...
    def __ge__(self, other: ArithRef | int) -> BoolRef: ...
    # Z3 comparison constructs a formula rather than a Python Boolean.
    def __eq__(self, other: object) -> BoolRef: ...  # type: ignore[override] # pyright: ignore[reportIncompatibleMethodOverride]
    def __ne__(self, other: object) -> BoolRef: ...  # type: ignore[override] # pyright: ignore[reportIncompatibleMethodOverride]

sat: CheckSatResult
unsat: CheckSatResult

def BitVec(name: str, bv: int) -> BitVecRef: ...
def BitVecVal(val: int, bv: int) -> BitVecRef: ...
def Int(name: str) -> ArithRef: ...
def Ints(names: str) -> list[ArithRef]: ...
def ZeroExt(n: int, a: BitVecRef) -> BitVecRef: ...
def LShR(a: BitVecRef, b: int) -> BitVecRef: ...
def Concat(*args: BitVecRef) -> BitVecRef: ...
def Extract(high: int, low: int, a: BitVecRef) -> BitVecRef: ...
def substitute(t: BitVecRef, *m: tuple[BitVecRef, BitVecRef]) -> BitVecRef: ...
def simplify(a: ArithRef, *, som: bool = False) -> ArithRef: ...
def ULE(a: BitVecRef, b: int) -> BoolRef: ...
def get_version_string() -> str: ...
