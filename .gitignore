## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

TestFailures.txt
TestFailures.txt.meta

PlaceHolderSummary.md
PlaceHolderSummary.md.meta

.vscode/**


.venv/**
.venv
.venv.meta

failed-tests-*.txt
failed-tests-*.txt.meta

scripts/wiki/__pycache__.meta

**__pycache__.meta

logs_*zip
logs_*zip.meta

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Agent session scaffolding (root level only)
/progress/
/progress.meta
/design-system/
/design-system.meta
/GOAL.md
/GOAL.md.meta
# The plan is scaffolding like the progress logs beside it: rewritten every session, read by the
# next one, and not part of what the package ships. The trailing `*` covers the scratch copies that
# appear next to it (PLAN.md.bak, PLAN.md.orig); anchoring to the root leaves a docs/PLAN.md, should
# one ever be written, tracked like any other documentation.
/PLAN.md*
/BACKUP_PLAN.md*

logs_extracted*

*.rsp.meta

# Claude Code config: ignore per-dev overrides but TRACK shared team config.
.claude/*
!.claude/settings.json
!.claude/.gitkeep
.codex/*

# Machine-local Unity MCP client configuration. The bridge endpoint (host:port) and
# its bearer token are per-developer, written by `npm run unity:mcp:configure` — never
# commit these. See docs/guides/mcp-local-setup.md. (.vscode/** and .codex/* above
# already cover the VS Code and Codex client configs.)
.mcp.json
.cursor/mcp.json
opencode.json
opencode.json.meta
# nanocoder's client config lives beside them and is per-developer for the same reason:
# it carries the provider and model a given machine is set up for, not just MCP servers.
agents.config.json
agents.config.json.meta
# The SOURCE of those endpoint values is per-developer too. Ignoring only the
# generated configs while tracking their input leaves the host address one
# `git add` away from being committed.
.env.local

_llm_*
_llm_*.meta
/.*/**/*.meta

