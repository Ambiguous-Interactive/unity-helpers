    "script": "param([string]$Original, [string]$Current, [string]$Root)\n$ErrorActionPreference = 'Stop'\n$records = [Collections.Generic.List[object]]::new()\n$sampleRoot = Join-Path $Root 'workspace-measure-fixture'\n[void][IO.Directory]::CreateDirectory($sampleRoot)\n$candidates = @(0..9 | ForEach-Object { @{Name=\"entry-$_\"; LastUsed=([datetime]'2020-01-01').AddDays($_); SizeBytes=1} })\nforeach ($pair in -2..6) {\n    $variants = @('original', 'typed')\n    if ($pair % 2 -ne 0) { [array]::Reverse($variants) }\n    foreach ($variant in $variants) {\n        if ($variant -eq 'original') { . $Original } else { . $Current }\n        foreach ($scenario in @('workspace', 'prune', 'retention-empty')) {\n            $clock = [Diagnostics.Stopwatch]::StartNew()\n            switch ($scenario) {\n                workspace { $value = Resolve-UnityProjectWorkspace -RepoRoot $sampleRoot -Version '6000.6.0f1' -Mode playmode -ShareEditorProject -Scope ' single-threaded ' -GenerationFingerprint '0123456789abcdef' }\n                prune { $value = @(Get-PersistentProjectPruneOrder -Candidates $candidates -FreeBytes 0 -MinimumFreeBytes 5) }\n                retention-empty { $value = Move-UnityProjectWithMigrationResidue -Project $sampleRoot }\n            }\n            $clock.Stop()\n            if ($scenario -eq 'workspace' -and $value.LeafName -ne 'f-09d2bebc44c97016') { throw 'Workspace result mismatch.' }\n            if ($scenario -eq 'prune' -and ($value -join ',') -ne 'entry-0,entry-1,entry-2,entry-3,entry-4') { throw 'Prune result mismatch.' }\n            if ($scenario -eq 'retention-empty' -and $null -ne $value) { throw 'Unexpected retention mutation.' }\n            $records.Add(@{pair=$pair; variant=$variant; scenario=$scenario; milliseconds=$clock.Elapsed.TotalMilliseconds})\n        }\n    }\n}\nConvertTo-Json -InputObject $records.ToArray() -Depth 10 -Compress\n",
