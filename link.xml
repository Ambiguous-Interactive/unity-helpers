<!--
  IL2CPP / AOT link preservation for the serialization stack.

  PackageLinkerProcessor supplies this descriptor for UPM installs because Unity does not
  automatically consume package-contained link.xml files. Assets installs use Unity's discovery.
  Preservation retains serialization metadata and members; it does not generate missing closed
  generic AOT methods or guarantee support for arbitrary runtime models.
-->
<linker>
  <assembly fullname="protobuf-net" preserve="all" ignoreIfMissing="true" />
  <assembly fullname="protobuf-net.Core" preserve="all" ignoreIfMissing="true" />
  <assembly fullname="System.Text.Json" preserve="all" />
  <assembly fullname="System.Collections.Immutable" preserve="all" />
  <assembly fullname="WallstopStudios.UnityHelpers" preserve="all" />
</linker>
